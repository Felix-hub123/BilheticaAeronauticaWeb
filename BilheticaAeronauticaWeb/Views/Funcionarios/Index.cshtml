@{
    ViewData["Title"] = "Painel do Funcionário";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <h1 class="mb-4"><i class="fa-solid fa-user-tie"></i> Painel do Funcionário</h1>

    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i>
        Bem-vindo, funcionário! Utilize o atalho abaixo para criar e gerir voos.
    </div>

    <div class="row">
        <!-- Gerir Voos -->
        <div class="col-md-12">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <i class="fa-solid fa-plane-departure fa-2x mb-2 text-success"></i>
                    <h5 class="card-title">Voos</h5>
                    <p class="card-text">Criar, editar e consultar voos.</p>
                    <a class="btn btn-outline-success mb-2" href="@Url.Action("Index", "Voo")">
                        <i class="fa-solid fa-plane-departure"></i> Gerir Voos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <hr />

    <div>
        <h4><i class="fa-solid fa-ellipsis-h"></i> Outras opções</h4>
        <ul class="list-unstyled">
            <li>
                <a href="@Url.Action("Index", "Home")" class="link-primary">
                    <i class="fa-solid fa-house"></i> Voltar ao Início
                </a>
            </li>
        </ul>
    </div>
</div>
