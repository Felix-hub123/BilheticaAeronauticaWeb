@model IEnumerable<BilheticaAeronauticaWeb.Models.AeroportosViewModel>

@{
    ViewData["Title"] = "Aeroportos";
}

<h1 class="mb-4">
    <i class="fa-solid fa-building-circle-arrow-right text-primary"></i>
    Aeroportos
</h1>

<div class="mb-3">
    <a asp-action="Create"
       class="btn btn-success">

        <i class="fa-solid fa-plus"></i>
        Novo Aeroporto

    </a>
</div>

<div class="table-responsive">

    <table class="table table-striped table-hover align-middle shadow-sm">

        <thead class="table-primary">

            <tr>

                <th>
                    Nome
                </th>

                <th>
                    Cidade
                </th>

                <th>
                    País
                </th>

                <th>
                    IATA
                </th>

                <th>
                    Imagem
                </th>

                <th class="text-center">
                    Ações
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Nome
                    </td>

                    <td>
                        @item.Cidade
                    </td>

                    <td>
                        @item.Pais
                    </td>

                    <td>
                        <span class="badge bg-primary">
                            @item.IATA
                        </span>
                    </td>

                    <td>

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="Imagem de @item.Nome"
                                 class="img-thumbnail shadow-sm"
                                 style="
                                            width:80px;
                                            height:55px;
                                            object-fit:cover;" />
                        }
                        else
                        {
                            <img src="/images/aeroportos/noimage.png"
                                 alt="Sem imagem"
                                 class="img-thumbnail"
                                 style="
                                            width:80px;
                                            height:55px;
                                            object-fit:cover;" />
                        }

                    </td>

                    <td class="text-center">

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm me-1"
                           title="Editar">

                            <i class="fa-solid fa-pen-to-square"></i>

                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm me-1 text-white"
                           title="Detalhes">

                            <i class="fa-solid fa-circle-info"></i>

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm"
                           title="Eliminar">

                            <i class="fa-solid fa-trash"></i>

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>