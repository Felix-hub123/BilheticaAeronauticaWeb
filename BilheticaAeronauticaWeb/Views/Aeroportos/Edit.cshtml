@model BilheticaAeronauticaWeb.Models.AeroportosViewModel

@{
    ViewData["Title"] = "Editar Aeroporto";
}

<h1 class="mb-4">
    <i class="fa-solid fa-building-circle-check text-primary"></i>
    Editar Aeroporto
</h1>

<div class="row">

    <div class="col-md-6">

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">

                        @foreach (var error in
                                            ViewData.ModelState.Values
                                            .SelectMany(v => v.Errors))
                        {
                            <p class="mb-1">
                                @error.ErrorMessage
                            </p>
                        }

                    </div>
                }

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <form asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data"
                      autocomplete="off">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="Id" />

                    <input type="hidden"
                           asp-for="ImageId" />

                    <div class="mb-3">

                        <label asp-for="Nome"
                               class="form-label">

                            <i class="fa-solid fa-building"></i>
                            Nome

                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Nome do aeroporto" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Cidade"
                               class="form-label">

                            <i class="fa-solid fa-city"></i>
                            Cidade

                        </label>

                        <input asp-for="Cidade"
                               class="form-control"
                               placeholder="Cidade" />

                        <span asp-validation-for="Cidade"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Pais"
                               class="form-label">

                            <i class="fa-solid fa-earth-europe"></i>
                            País

                        </label>

                        <input asp-for="Pais"
                               class="form-control"
                               placeholder="País" />

                        <span asp-validation-for="Pais"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="IATA"
                               class="form-label">

                            <i class="fa-solid fa-code"></i>
                            Código IATA

                        </label>

                        <input asp-for="IATA"
                               class="form-control"
                               placeholder="Ex: LIS"
                               maxlength="3" />

                        <span asp-validation-for="IATA"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="ImageFile"
                               class="form-label">

                            <i class="fa-solid fa-image"></i>
                            Nova Imagem

                        </label>

                        <input asp-for="ImageFile"
                               class="form-control"
                               type="file"
                               accept=".jpg,.jpeg" />

                        <span asp-validation-for="ImageFile"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Se não selecionar uma nova imagem,
                            a imagem atual será mantida.
                        </div>

                    </div>

                    <div class="d-flex justify-content-between">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="fa-solid fa-floppy-disk"></i>
                            Guardar

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="fa-solid fa-arrow-left"></i>
                            Voltar à Lista

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <div class="col-md-6
                d-flex
                flex-column
                align-items-center">

        <div class="mb-2 fw-bold">

            <i class="fa-solid fa-image"></i>
            Imagem Atual

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="Imagem do aeroporto"
                 class="img-thumbnail mb-3 shadow-sm"
                 style="
                        max-width:300px;
                        max-height:220px;
                        object-fit:cover;" />
        }
        else
        {
            <img src="/images/aeroportos/noimage.png"
                 alt="Sem imagem disponível"
                 class="img-thumbnail mb-3"
                 style="
                        max-width:300px;
                        max-height:220px;
                        object-fit:cover;" />
        }

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}