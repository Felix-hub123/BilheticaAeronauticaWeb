@model BilheticaAeronauticaWeb.Data.Entities.Aeroporto

@{
    ViewData["Title"] = "Eliminar Aeroporto";
}

<h1 class="mb-4 text-danger">
    <i class="fa-solid fa-trash-can"></i> Eliminar Aeroporto
</h1>

<div class="alert alert-warning d-flex align-items-center" role="alert">
    <i class="fa-solid fa-triangle-exclamation fa-lg me-2"></i>
    <div>
        Tem a certeza que deseja eliminar este aeroporto? Esta ação não pode ser desfeita.
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3"><i class="fa-solid fa-building-circle-arrow-right text-primary"></i> Nome</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>

            <dt class="col-sm-3"><i class="fa-solid fa-city text-primary"></i> Cidade</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Cidade)</dd>

            <dt class="col-sm-3"><i class="fa-solid fa-earth-europe text-primary"></i> País</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Pais)</dd>

            <dt class="col-sm-3"><i class="fa-solid fa-code text-primary"></i> Código IATA</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.IATA)</dd>

            <dt class="col-sm-3"><i class="fa-solid fa-image text-primary"></i> Imagem</dt>
            <dd class="col-sm-9">
                <img src="@Url.Content(Model.ImageFullPath)" alt="Imagem do aeroporto" style="max-width:200px; height:auto;" class="img-thumbnail" />
            </dd>
        </dl>
        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash"></i> Eliminar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="fa-solid fa-arrow-left"></i> Voltar à Lista
            </a>
        </form>
    </div>
</div>

