@model BilheticaAeronauticaWeb.Models.AeroportosViewModel

@{
    ViewData["Title"] = "Eliminar Aeroporto";
}

<h1 class="mb-4">
    <i class="fa-solid fa-trash text-danger"></i> Eliminar Aeroporto
</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger mb-3">@ViewBag.ErrorMessage</div>
                }

                <h4>Tem certeza que deseja eliminar este aeroporto?</h4>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Nome</dt>
                    <dd class="col-sm-8">@Model.Nome</dd>

                    <dt class="col-sm-4">Cidade</dt>
                    <dd class="col-sm-8">@Model.Cidade</dd>

                    <dt class="col-sm-4">País</dt>
                    <dd class="col-sm-8">@Model.Pais</dd>

                    <dt class="col-sm-4">Código IATA</dt>
                    <dd class="col-sm-8">@Model.IATA</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger me-2">
                        <i class="fa-solid fa-trash"></i> Confirmar Exclusão
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Cancelar
                    </a>
                </form>

            </div>
        </div>
    </div>

    <div class="col-md-6 d-flex flex-column align-items-center">
        <div class="mb-2 fw-bold">
            <i class="fa-solid fa-image"></i> Imagem do Aeroporto
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageFullPath))
        {
            <img src="@Url.Content(Model.ImageFullPath)" alt="Imagem do aeroporto" class="img-thumbnail mb-3" style="max-width: 300px; height: auto;" />
        }
        else
        {
            <div class="alert alert-secondary mb-3" style="max-width: 300px; text-align:center;">
                Sem imagem disponível
            </div>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}



