@model BilheticaAeronauticaWeb.Models.AeroportosViewModel

@{
    ViewData["Title"] = "Criar Aeroporto";
}

<h1 class="mb-4">
    <i class="fa-solid fa-building-circle-arrow-right text-primary"></i> Criar Aeroporto
</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Create" enctype="multipart/form-data" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"><i class="fa-solid fa-building"></i> Nome</label>
                <input asp-for="Nome" class="form-control" placeholder="Nome do aeroporto" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Cidade" class="form-label"><i class="fa-solid fa-city"></i> Cidade</label>
                <input asp-for="Cidade" class="form-control" placeholder="Cidade" />
                <span asp-validation-for="Cidade" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Pais" class="form-label"><i class="fa-solid fa-earth-europe"></i> País</label>
                <input asp-for="Pais" class="form-control" placeholder="País" />
                <span asp-validation-for="Pais" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IATA" class="form-label"><i class="fa-solid fa-code"></i> Código IATA</label>
                <input asp-for="IATA" class="form-control" placeholder="Ex: LIS" maxlength="3" />
                <span asp-validation-for="IATA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ImageFile" class="form-label"><i class="fa-solid fa-image"></i> Imagem</label>
                <input asp-for="ImageFile" class="form-control" type="file" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success">
                    <i class="fa-solid fa-plus"></i> Criar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Voltar à Lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

}
