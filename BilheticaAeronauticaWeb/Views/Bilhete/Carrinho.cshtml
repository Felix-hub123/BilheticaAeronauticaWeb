@using BilheticaAeronauticaWeb.Data.Entities
@model IEnumerable<BilheteTemp>

@{
    ViewData["Title"] = "Carrinho de Reservas";
    var bilhetes = Model.ToList();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <span>
                <i class="fa-solid fa-shopping-cart"></i> Carrinho de Reservas
            </span>
            <a asp-action="Historico" asp-controller="Bilhete" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-list"></i> Ver Histórico de Bilhetes
            </a>
        </div>
        <div class="card-body">
            @if (!bilhetes.Any())
            {
                <div class="alert alert-warning">
                    <i class="fa-solid fa-info-circle"></i> O seu carrinho está vazio.
                </div>
            }
            else
            {
                <form id="formCompra" asp-action="Comprar" method="post">
                    <input type="hidden" id="idBilheteSelecionado" name="idBilheteSelecionado" value="@bilhetes.First().Id" />
                    <div class="table-responsive">
                        <table class="table table-striped align-middle" id="tabelaBilhetes">
                            <thead class="table-light">
                                <tr>
                                    <th>Voo</th>
                                    <th>Passageiro</th>
                                    <th>Lugar</th>
                                    <th>Preço</th>
                                    <th>Extras</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < bilhetes.Count; i++)
                                {
                                    var item = bilhetes[i];
                                    <tr class="bilhete-item @(i == 0 ? "table-primary" : "")" tabindex="0" data-index="@i" data-id="@item.Id">
                                        <td>
                                            @if (item.Voo != null)
                                            {
                                                <span>@item.Voo.Numero - @item.Voo.Origem?.Nome → @item.Voo.Destino?.Nome</span>
                                            }
                                            else
                                            {
                                                <span>@item.VooId</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Passageiro != null)
                                            {
                                                <span>@item.Passageiro.FullName</span>
                                            }
                                            else
                                            {
                                                <span>@item.PassageiroId</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Lugar != null)
                                            {
                                                <span>@item.Lugar.Codigo</span>
                                            }
                                            else
                                            {
                                                <span>@item.LugarId</span>
                                            }
                                        </td>
                                        <td>@item.Preco.ToString("C")</td>
                                        <td>
                                            @if (item.BagagemExtra)
                                            {
                                                <span class="badge bg-secondary">Bagagem</span>
                                            }
                                            @if (item.Refeicao)
                                            {
                                                <span class="badge bg-info text-dark">Refeição</span>
                                            }
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-danger btn-sm btn-remover" data-id="@item.Id" data-bs-toggle="modal" data-bs-target="#modalRemover">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-success mt-3" data-bs-toggle="modal" data-bs-target="#modalComprar">
                        <i class="fa-solid fa-credit-card"></i> Comprar Selecionado
                    </button>
                </form>
            }
        </div>
    </div>
</div>


<div class="modal fade" id="modalComprar" tabindex="-1" aria-labelledby="modalComprarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalComprarLabel">
                    <i class="fa-solid fa-credit-card"></i> Confirmar Compra
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                Tem a certeza que deseja comprar o bilhete selecionado?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarCompra" class="btn btn-success">
                    <i class="fa-solid fa-credit-card"></i> Comprar
                </button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalRemover" tabindex="-1" aria-labelledby="modalRemoverLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalRemoverLabel"><i class="fa-solid fa-trash"></i> Confirmar Remoção</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                Tem a certeza que deseja remover este bilhete do carrinho?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <a id="btnConfirmRemover" class="btn btn-danger" href="#"><i class="fa-solid fa-trash"></i> Remover</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            let $items = $('.bilhete-item');
            let selectedIndex = 0;

            function focusItem(index) {
                $items.removeClass('table-primary');
                $items.eq(index).addClass('table-primary').focus();
                selectedIndex = index;
                $('#idBilheteSelecionado').val($items.eq(selectedIndex).data('id'));
            }

            if ($items.length > 0) {
                focusItem(0);
            }

            $(document).keydown(function (e) {
                if (!$items.length) return;

                if (e.key === "ArrowDown") {
                    if (selectedIndex < $items.length - 1) focusItem(selectedIndex + 1);
                    e.preventDefault();
                } else if (e.key === "ArrowUp") {
                    if (selectedIndex > 0) focusItem(selectedIndex - 1);
                    e.preventDefault();
                } else if (e.key === "Delete") {
                    let reservaId = $items.eq(selectedIndex).data('id');
                    var url = '@Url.Action("RemoverReserva", "Bilhete")/' + reservaId;
                    $('#btnConfirmRemover').attr('href', url);
                    var modal = new bootstrap.Modal(document.getElementById('modalRemover'));
                    modal.show();
                    e.preventDefault();
                }
            });

            $items.click(function () {
                let idx = $items.index(this);
                focusItem(idx);
            });

            $('.btn-remover').click(function () {
                let reservaId = $(this).data('id');
                var url = '@Url.Action("RemoverReserva", "Bilhete")/' + reservaId;
                $('#btnConfirmRemover').attr('href', url);
            });

            $('#btnConfirmarCompra').click(function () {
                $('#formCompra').submit();
            });
        });
    </script>
}

