@model BilheteViewModel

@{
    ViewData["Title"] = "Editar Bilhete";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <i class="fa-solid fa-pen-to-square"></i> Editar Bilhete
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="VooId" class="form-label">Voo</label>
                    <select asp-for="VooId" asp-items="Model.Voos" class="form-select" id="VooId"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="PassageiroId" class="form-label">Passageiro</label>
                    <select asp-for="PassageiroId" asp-items="Model.Passageiros" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="LugarId" class="form-label">Lugar</label>
                    <select asp-for="LugarId" asp-items="Model.Lugares" class="form-select" id="LugarId"></select>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="BagagemExtra" class="form-check-input" id="BagagemExtra" />
                    <label asp-for="BagagemExtra" class="form-check-label">Bagagem Extra (+30€)</label>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="Refeicao" class="form-check-input" id="Refeicao" />
                    <label asp-for="Refeicao" class="form-check-label">Refeição (+20€)</label>
                </div>
                <div class="mb-3">
                    <label asp-for="Valor" class="form-label">Preço</label>
                    <input asp-for="Valor" class="form-control" id="Valor" readonly />
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-save"></i> Guardar Alterações
                </button>
                <a asp-action="Historico" class="btn btn-secondary ms-2">
                    <i class="fa-solid fa-arrow-left"></i> Cancelar
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function atualizarPreco() {
            var vooId = $('#VooId').val();
            var lugarId = $('#LugarId').val();
            var bagagemExtra = $('#BagagemExtra').is(':checked');
            var refeicao = $('#Refeicao').is(':checked');
            if (vooId && lugarId) {
                $.getJSON('@Url.Action("CalcularPreco", "Bilhete")', {
                    vooId: vooId,
                    lugarId: lugarId,
                    bagagemExtra: bagagemExtra,
                    refeicao: refeicao
                }, function (preco) {
                    $('#Valor').val(preco.toFixed(2));
                });
            } else {
                $('#Valor').val('');
            }
        }
        $(function () {
            $('#VooId').change(function () {
                var vooId = $(this).val();
                if (vooId) {
                    $.getJSON('@Url.Action("LugaresDisponiveis", "Bilhete")', { vooId: vooId }, function (data) {
                        var $lugarSelect = $('#LugarId');
                        $lugarSelect.empty();
                        $.each(data, function (i, lugar) {
                            $lugarSelect.append($('<option>', {
                                value: lugar.value,
                                text: lugar.text
                            }));
                        });
                        atualizarPreco();
                    });
                } else {
                    $('#LugarId').empty();
                    atualizarPreco();
                }
            });
            $('#LugarId, #BagagemExtra, #Refeicao').change(atualizarPreco);
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}





