@{
    ViewData["Title"] = "Compra realizada com sucesso";
}

<div class="container mt-4">
    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">Obrigado pela sua compra!</h4>
        <p>@ViewBag.Mensagem</p>
        <hr />
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fa-solid fa-house me-1"></i> Voltar ao Início
            </a>
            <a asp-controller="Bilhete" asp-action="Historico" class="btn btn-success">
                <i class="fa-solid fa-list-check me-1"></i> Ver Histórico de Bilhetes
            </a>
            <a asp-controller="Bilhete" asp-action="Carrinho" class="btn btn-warning">
                <i class="fa-solid fa-shopping-cart me-1"></i> Ver Carrinho
            </a>
            <a asp-controller="Conta" asp-action="Perfil" class="btn btn-info">
                <i class="fa-solid fa-user me-1"></i> O Meu Perfil
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
}

