@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var modelState in ViewData.ModelState.Values)
            foreach (var error in modelState.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
    </div>
}


@model BilheteViewModel

@{
    ViewData["Title"] = "Adicionar Reserva";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <i class="fa-solid fa-ticket-alt"></i> Adicionar Reserva
        </div>
        <div class="card-body">

            <div class="mb-3">
                <a asp-action="Carrinho" asp-controller="Bilhete" class="btn btn-info">
                    <i class="fa-solid fa-shopping-cart"></i> Ver Carrinho de Reservas
                </a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="AdicionarReserva" method="post" autocomplete="off">
                <input type="hidden" asp-for="PassageiroId" />

                <div class="mb-3">
                    <label asp-for="VooId" class="form-label">Voo</label>
                    <select asp-for="VooId" asp-items="Model.Voos" class="form-select" id="VooId"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="LugarId" class="form-label">Lugar</label>
                    <select asp-for="LugarId" asp-items="Model.Lugares" class="form-select" id="LugarId"></select>
                    <small class="text-muted">Lugares marcados como <b>(ocupado)</b> não podem ser escolhidos.</small>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="BagagemExtra" class="form-check-input" id="BagagemExtra" />
                    <label asp-for="BagagemExtra" class="form-check-label">Bagagem Extra (+30€)</label>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="Refeicao" class="form-check-input" id="Refeicao" />
                    <label asp-for="Refeicao" class="form-check-label">Refeição (+20€)</label>
                </div>
                <div class="mb-3">
                    <input type="text" id="Valor_Visivel" class="form-control" readonly />
                    <input type="hidden" asp-for="Valor" />



                </div>

                <button type="submit" class="btn btn-success mt-3 mb-5">
                    <i class="fa-solid fa-plus"></i> Reservar
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Atualiza a dropdown dos lugares com base no voo selecionado
        function atualizarLugares() {
            var vooId = $('#VooId').val();
            var $lugarSelect = $('#LugarId');
            $lugarSelect.empty();

            if (vooId) {
                $.getJSON('@Url.Action("LugaresDisponiveis", "Bilhete")', { vooId: vooId }, function (data) {
                    $.each(data, function (i, lugar) {
                        var option = $('<option>', {
                            value: lugar.value,
                            text: lugar.text
                        });
                        if (lugar.disabled) {
                            option.prop('disabled', true);
                            option.attr('title', 'Este lugar está ocupado');
                        }
                        $lugarSelect.append(option);
                    });

                    atualizarPreco(); // Atualiza o preço com o novo lugar
                });
            } else {
                atualizarPreco(); // Sem voo: só limpa o preço
            }
        }

        // Calcula o preço com base nos dados selecionados
        function atualizarPreco() {
            var vooId = $('#VooId').val();
            var lugarId = $('#LugarId').val();
            var bagagemExtra = $('#BagagemExtra').is(':checked');
            var refeicao = $('#Refeicao').is(':checked');

            if (vooId && lugarId) {
                $.getJSON('@Url.Action("CalcularPreco", "Bilhete")', {
                    vooId: vooId,
                    lugarId: lugarId,
                    bagagemExtra: bagagemExtra,
                    refeicao: refeicao
                }, function (preco) {
                    $('#Valor_Visivel').val(preco.toFixed(2));
                    $('input[name="Valor"]').val(preco.toFixed(2));
                });
            } else {
                $('#Valor_Visivel').val('');
                $('input[name="Valor"]').val('');
            }
        }

    
        $(document).ready(function () {
            atualizarLugares();


            $('#VooId').change(function () {
                atualizarLugares();
            });

 
            $('#LugarId, #BagagemExtra, #Refeicao').change(function () {
                atualizarPreco();
            });
        });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}

 




