@model BilheteViewModel

@{
    ViewData["Title"] = "Adicionar Reserva";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <i class="fa-solid fa-ticket-alt"></i> Adicionar Reserva
        </div>
        <div class="card-body">

        
            <div class="mb-3">
                <a asp-action="Carrinho" asp-controller="Bilhete" class="btn btn-info">
                    <i class="fa-solid fa-shopping-cart"></i> Ver Carrinho de Reservas
                </a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="AdicionarReserva" method="post">
                <input type="hidden" asp-for="PassageiroId" />

                <div class="mb-3">
                    <label asp-for="VooId" class="form-label">Voo</label>
                    <select asp-for="VooId" asp-items="Model.Voos" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="LugarId" class="form-label">Lugar</label>
                    <select asp-for="LugarId" asp-items="Model.Lugares" class="form-select"></select>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="BagagemExtra" class="form-check-input" />
                    <label asp-for="BagagemExtra" class="form-check-label">Bagagem Extra (+30€)</label>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="Refeicao" class="form-check-input" />
                    <label asp-for="Refeicao" class="form-check-label">Refeição (+20€)</label>
                </div>
                <div class="mb-3">
                    <label asp-for="Valor" class="form-label">Preço</label>
                    <input asp-for="Valor" class="form-control" id="Valor" readonly />
                </div>

                <form asp-action="AdicionarReserva" method="post">
                    <button type="submit" class="btn btn-success mt-3 mb-5">
                        <i class="fa-solid fa-plus"></i> Reservar
                    </button>
                </form>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function atualizarLugares() {
            var vooId = $('#VooId').val();
            if (vooId) {
                $.getJSON('@Url.Action("LugaresDisponiveis", "Bilhete")', { vooId: vooId }, function (data) {
                    var $lugarSelect = $('#LugarId');
                    $lugarSelect.empty();
                    $.each(data, function (i, lugar) {
                        $lugarSelect.append($('<option>', {
                            value: lugar.value,
                            text: lugar.text
                        }));
                    });
                  
                    atualizarPreco();
                });
            } else {
                $('#LugarId').empty();
                atualizarPreco();
            }
        }

        function atualizarPreco() {
            var vooId = $('#VooId').val();
            var lugarId = $('#LugarId').val();
            var bagagemExtra = $('#BagagemExtra').is(':checked');
            var refeicao = $('#Refeicao').is(':checked');

            if (vooId && lugarId) {
                $.getJSON('@Url.Action("CalcularPreco", "Bilhete")', {
                    vooId: vooId,
                    lugarId: lugarId,
                    bagagemExtra: bagagemExtra,
                    refeicao: refeicao
                }, function (preco) {
                   $('#Valor').val(preco.toFixed(2));

                });
            } else {
                $('#Valor').val('');
            }
        }

        $(function () {
            $('#VooId').change(atualizarLugares);
            $('#LugarId, #BagagemExtra, #Refeicao').change(atualizarPreco);
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}




