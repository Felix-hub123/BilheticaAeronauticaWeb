@using BilheticaAeronauticaWeb.Data.Entities
@model Bilhete

@{
    ViewData["Title"] = "Anular Bilhete";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <i class="fa-solid fa-ban"></i> Confirmar Anulação do Bilhete
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="fa-solid fa-triangle-exclamation"></i>
                Tem a certeza que deseja <strong>anular</strong> este bilhete? Esta ação não pode ser revertida!
            </div>
            <dl class="row">
        
            </dl>
            <form asp-action="Anular" method="post" id="anularForm">
                <input type="hidden" asp-for="Id" />
                <button type="button" class="btn btn-danger" id="btnConfirmAnular">
                    <i class="fa-solid fa-ban"></i> Anular Bilhete
                </button>
                <a asp-action="Historico" class="btn btn-secondary ms-2">
                    <i class="fa-solid fa-arrow-left"></i> Cancelar
                </a>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="confirmDialog" tabindex="-1" aria-labelledby="confirmDialogLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDialogLabel"><i class="fa-solid fa-ban"></i> Confirmar Anulação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                Tem a certeza que deseja <strong>anular</strong> este bilhete? Esta ação não pode ser revertida!
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnNoConfirm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnYesConfirm">Anular</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            var confirmModal = new bootstrap.Modal(document.getElementById('confirmDialog'));

            $("#btnConfirmAnular").click(function () {
                confirmModal.show();
                return false;
            });

            $("#btnYesConfirm").click(function () {
                $("#anularForm").submit();
            });

           
        });
    </script>
}



