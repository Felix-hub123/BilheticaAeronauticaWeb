<dl class="row">
    <dt class="col-sm-3">Nº Bilhete</dt>
    <dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">Voo</dt>
    <dd class="col-sm-9">
        @($"{Model.Voo?.Origem?.Nome} → {Model.Voo?.Destino?.Nome} ({Model.Voo?.Numero})")
    </dd>
    <dt class="col-sm-3">Lugar</dt>
    <dd class="col-sm-9">@Model.Lugar?.Codigo</dd>
    <dt class="col-sm-3">Nome do Passageiro</dt>
    <dd class="col-sm-9">@Model.Passageiro?.Nome</dd>
    <dt class="col-sm-3">Valor Pago</dt>
    <dd class="col-sm-9">@Model.Valor.ToString("C")</dd>
    <dt class="col-sm-3">Data de Compra</dt>
    <dd class="col-sm-9">@Model.DataCompra?.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>




