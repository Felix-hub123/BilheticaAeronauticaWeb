@model BilheticaAeronauticaWeb.Models.HistoricoViewModel

@{
    ViewData["Title"] = "Histórico de Bilhetes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-secondary text-white">
            <i class="fa-solid fa-history"></i> Histórico de Bilhetes
        </div>
        <div class="card-body">

            <h5 class="mb-3"><i class="fa-solid fa-plane-departure"></i> Viagens Futuras</h5>
            @if (!Model.Futuros.Any())
            {
                <div class="alert alert-info">Não tem viagens futuras.</div>
            }
            else
            {
                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Voo</th>
                                <th>Lugar</th>
                                <th>Preço</th>
                                <th>Extras</th>
                                <th>Data</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bilhete in Model.Futuros)
                            {
                                <tr>
                                    <td>@bilhete.VooNumero - @bilhete.OrigemNome → @bilhete.DestinoNome</td>
                                    <td>@bilhete.LugarCodigo</td>
                                    <td>@bilhete.Valor.ToString("C")</td>
                                    <td>
                                        @if (bilhete.BagagemExtra)
                                        {
                                            <span class="badge bg-secondary me-1">Bagagem</span>
                                        }
                                        @if (bilhete.Refeicao)
                                        {
                                            <span class="badge bg-info text-dark">Refeição</span>
                                        }
                                        @if (!bilhete.BagagemExtra && !bilhete.Refeicao)
                                        {
                                            <span>Sem extras</span>
                                        }
                                    </td>
                                    <td>@bilhete.DataPartida.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (bilhete.WasDeleted)
                                        {
                                            <span class="badge bg-danger">Anulado</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-success">Ativo</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Detalhes" asp-route-id="@bilhete.Id" class="btn btn-info btn-sm" title="Detalhes">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        @if (!bilhete.WasDeleted)
                                        {
                                            <form asp-action="Cancelar" asp-route-id="@bilhete.Id" method="post" style="display:inline">
                                                <button type="submit" class="btn btn-danger btn-sm ms-1" title="Anular"
                                                        onclick="return confirm('Tem a certeza que quer anular este bilhete?');">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            </form>
                                            <a asp-action="DownloadPdf" asp-route-id="@bilhete.Id" class="btn btn-danger btn-sm ms-1" title="Download PDF">
                                                <i class="fa-solid fa-file-pdf"></i> PDF
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h5 class="mb-3"><i class="fa-solid fa-plane-arrival"></i> Viagens Passadas</h5>
            @if (!Model.Passados.Any())
            {
                <div class="alert alert-info">Não tem viagens passadas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Voo</th>
                                <th>Lugar</th>
                                <th>Preço</th>
                                <th>Extras</th>
                                <th>Data</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bilhete in Model.Passados)
                            {
                                <tr>
                                    <td>@bilhete.VooNumero - @bilhete.OrigemNome → @bilhete.DestinoNome</td>
                                    <td>@bilhete.LugarCodigo</td>
                                    <td>@bilhete.Valor.ToString("C")</td>
                                    <td>
                                        @if (bilhete.BagagemExtra)
                                        {
                                            <span class="badge bg-secondary me-1">Bagagem</span>
                                        }
                                        @if (bilhete.Refeicao)
                                        {
                                            <span class="badge bg-info text-dark">Refeição</span>
                                        }
                                        @if (!bilhete.BagagemExtra && !bilhete.Refeicao)
                                        {
                                            <span>Sem extras</span>
                                        }
                                    </td>
                                    <td>@bilhete.DataPartida.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (bilhete.WasDeleted)
                                        {
                                            <span class="badge bg-danger">Anulado</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary">Terminado</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Detalhes" asp-route-id="@bilhete.Id" class="btn btn-info btn-sm" title="Detalhes">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="DownloadPdf" asp-route-id="@bilhete.Id" class="btn btn-danger btn-sm ms-1" title="Download PDF">
                                            <i class="fa-solid fa-file-pdf"></i> PDF
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>


