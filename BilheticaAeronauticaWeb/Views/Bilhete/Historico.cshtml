@model IEnumerable<BilheticaAeronauticaWeb.Models.BilheteViewModel>


@{
    ViewData["Title"] = "Histórico de Bilhetes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-secondary text-white">
            <i class="fa-solid fa-history"></i> Histórico de Bilhetes
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fa-solid fa-info-circle"></i> Não existem bilhetes comprados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Voo</th>
                                <th>Passageiro</th>
                                <th>Lugar</th>
                                <th>Preço</th>
                                <th>Extras</th>
                                <th>Data</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bilhete in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(bilhete.VooNumero))
                                        {
                                            <span>@bilhete.VooNumero - @bilhete.OrigemNome → @bilhete.DestinoNome</span>
                                        }
                                        else
                                        {
                                            <span>@bilhete.VooId</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(bilhete.PassageiroNome))
                                        {
                                            <span>@bilhete.PassageiroNome</span>
                                        }
                                        else
                                        {
                                            <span>@bilhete.PassageiroId</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(bilhete.LugarCodigo))
                                        {
                                            <span>@bilhete.LugarCodigo</span>
                                        }
                                        else
                                        {
                                            <span>@bilhete.LugarId</span>
                                        }
                                    </td>
                                    <td>@bilhete.Valor.ToString("C")</td>
                                    <td>
                                        @if (bilhete.BagagemExtra)
                                        {
                                            <span class="badge bg-secondary">Bagagem</span>
                                        }
                                        @if (bilhete.Refeicao)
                                        {
                                            <span class="badge bg-info text-dark">Refeição</span>
                                        }
                                        @if (!bilhete.BagagemExtra && !bilhete.Refeicao)
                                        {
                                            <span>Sem extras</span>
                                        }
                                </td>
                                <td>
                                    @(bilhete.DataCompra.HasValue
                                                                    ? bilhete.DataCompra.Value.ToShortDateString()
                                                                    : "N/A")
                            </td>
                            <td>
                                @if (bilhete.Anulado)
                                        {
                                            <span class="badge bg-danger">Anulado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Ativo</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Detalhes" asp-route-id="@bilhete.Id" class="btn btn-info btn-sm" title="Detalhes">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") && !bilhete.Anulado)
                                        {
                                            <a asp-action="Anular" asp-route-id="@bilhete.Id" class="btn btn-danger btn-sm ms-1" title="Anular">
                                                <i class="fa-solid fa-ban"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
