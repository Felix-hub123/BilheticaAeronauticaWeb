@model IEnumerable<BilheticaAeronauticaWeb.Models.UserViewModel>

@{
    ViewData["Title"] = "Administradores";
}

<h2 class="mb-4">
    <i class="fa-solid fa-user-shield text-primary"></i> Administradores
</h2>

<p>
    <a asp-action="Create" class="btn btn-success">
        <i class="fa-solid fa-user-plus"></i> Novo Administrador
    </a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th><i class="fa-solid fa-image"></i> Foto</th>
                <th><i class="fa-solid fa-user"></i> Nome</th>
                <th><i class="fa-solid fa-envelope"></i> Email</th>
                <th style="width:180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageFullPath))
                        {
                            <img src="@item.ImageFullPath" alt="Foto" class="img-thumbnail shadow" style="max-width: 60px; max-height: 60px;" />
                        }
                        else
                        {
                            <span class="text-muted"><i class="fa-solid fa-user"></i></span>
                        }
                    </td>
                    <td>@item.Nome</td>
                    <td>@item.Email</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm me-1" title="Detalhes">
                            <i class="fa-solid fa-circle-info"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1" title="Editar">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Eliminar">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
