@model UserViewModel

@{
    ViewData["Title"] = "Eliminar Administrador";
}

<h2 class="mb-4 text-danger">
    <i class="fa-solid fa-user-xmark"></i> Eliminar Administrador
</h2>

<div class="alert alert-warning mb-4">
    <i class="fa-solid fa-triangle-exclamation"></i>
    Tem a certeza que deseja eliminar este administrador? Esta ação não pode ser desfeita.
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
        </dl>
        @if (!string.IsNullOrEmpty(Model.ImageFullPath))
        {
            <div class="mt-3 text-center">
                <img src="@Model.ImageFullPath"
                     alt="Fotografia do Administrador"
                     class="img-thumbnail shadow"
                     style="max-width: 200px; max-height: 200px;" />
            </div>
        }
    </div>
</div>

<form asp-action="DeleteConfirmed" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash"></i> Eliminar
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-ban"></i> Cancelar
        </a>
    </div>
</form>



