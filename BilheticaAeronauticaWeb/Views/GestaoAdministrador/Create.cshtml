@model BilheticaAeronauticaWeb.Models.UserViewModel

@{
    ViewData["Title"] = "Criar Administrador";
}

<h2 class="mb-4">
    <i class="fa-solid fa-user-shield text-primary"></i>
    Criar Administrador
</h2>

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              autocomplete="off">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="mb-3">

                <label asp-for="Nome"
                       class="form-label">

                    <i class="fa-solid fa-user"></i>
                    Nome

                </label>

                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Nome do administrador" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">

                    <i class="fa-solid fa-envelope"></i>
                    Email

                </label>

                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       placeholder="exemplo@email.com" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Password"
                       class="form-label">

                    <i class="fa-solid fa-lock"></i>
                    Password

                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="ImageFile"
                       class="form-label">

                    <i class="fa-solid fa-image"></i>
                    Fotografia

                </label>

                <input asp-for="ImageFile"
                       type="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" />

                <span asp-validation-for="ImageFile"
                      class="text-danger">
                </span>

                <div class="form-text">
                    Formatos permitidos: JPG, JPEG, PNG e WEBP.
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-success">

                    <i class="fa-solid fa-user-plus"></i>
                    Criar

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="fa-solid fa-ban"></i>
                    Cancelar

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



