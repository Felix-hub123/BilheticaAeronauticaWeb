@model UserViewModel

@{
    ViewData["Title"] = "Detalhes do Administrador";
}

<h2 class="mb-4">
    <i class="fa-solid fa-user-shield text-primary"></i> Detalhes do Administrador
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
        </dl>
        @if (!string.IsNullOrEmpty(Model.ImageFullPath))
        {
            <div class="mt-3 text-center">
                <img src="@Model.ImageFullPath"
                     alt="Fotografia do Administrador"
                     class="img-thumbnail shadow"
                     style="max-width: 200px; max-height: 200px;" />
            </div>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="fa-solid fa-pen-to-square"></i> Editar
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i> Voltar à lista
    </a>
</div>

