@model IEnumerable<UserViewModel>

@{
    ViewData["Title"] = "Funcionários";
}

<h2>Funcionários</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Funcionário</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nome</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageFullPath))
                    {
                        <img src="@item.ImageFullPath" alt="Foto" style="max-width: 60px; max-height: 60px;" />
                    }
                </td>
                <td>@item.Nome</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Ver</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
