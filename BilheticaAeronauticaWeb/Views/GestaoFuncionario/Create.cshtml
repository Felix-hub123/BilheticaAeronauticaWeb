@model BilheticaAeronauticaWeb.Models.RegisterFuncionarioViewModel

@{
    ViewData["Title"] = "Criar Funcionário";
}

<h2 class="mb-4">
    <i class="fa-solid fa-user-plus text-primary"></i>
    Criar Funcionário
</h2>

<form asp-controller="GestaoFuncionario"
      asp-action="Create"
      method="post"
      autocomplete="off">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    @if (ViewBag.Mensagem != null)
    {
        <div class="container-fluid">

            <div class="alert alert-success
                            d-flex
                            align-items-start
                            justify-content-center
                            shadow-lg
                            p-5
                            rounded-4
                            mt-5
                            border
                            border-success-subtle"
                 role="alert"
                 style="font-size:1.4rem; max-width:100%;">

                <i class="fa-solid fa-circle-check
                              fa-4x
                              me-4
                              text-success">
                </i>

                <div>

                    <h3 class="alert-heading fw-bold mb-3">
                        Funcionário Criado com Sucesso
                    </h3>

                    <p class="mb-3">
                        @ViewBag.Mensagem
                    </p>

                    <hr />

                    <p class="mb-0 text-muted">
                        Foi enviado um e-mail para definição
                        da password.
                    </p>

                </div>

            </div>

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="mb-3">

                <label asp-for="Nome"
                       class="form-label">

                    <i class="fa-solid fa-user"></i>
                    Nome

                </label>

                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Nome do funcionário" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Apelido"
                       class="form-label">

                    <i class="fa-solid fa-user"></i>
                    Apelido

                </label>

                <input asp-for="Apelido"
                       class="form-control"
                       placeholder="Apelido do funcionário" />

                <span asp-validation-for="Apelido"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">

                    <i class="fa-solid fa-envelope"></i>
                    Email

                </label>

                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       placeholder="exemplo@email.com" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="PhoneNumber"
                       class="form-label">

                    <i class="fa-solid fa-phone"></i>
                    Telefone

                </label>

                <input asp-for="PhoneNumber"
                       class="form-control"
                       placeholder="Número de telefone" />

                <span asp-validation-for="PhoneNumber"
                      class="text-danger">
                </span>

            </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa-solid fa-user-plus"></i>
                    Criar Funcionário

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="fa-solid fa-arrow-left"></i>
                    Voltar

                </a>

            </div>

        </div>

    </div>

</form>

@if (TempData["ShowSuccessModal"] != null)
{
    <div class="modal fade"
         id="successModal"
         tabindex="-1"
         aria-labelledby="modalLabel"
         aria-hidden="true">

        <div class="modal-dialog
                        modal-dialog-centered
                        modal-lg">

            <div class="modal-content">

                <div class="modal-header
                                bg-success
                                text-white">

                    <h5 class="modal-title"
                        id="modalLabel">

                        Funcionário Criado

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Fechar">
                    </button>

                </div>

                <div class="modal-body fs-5">

                    Funcionário criado com sucesso!
                    <br />

                    Um e-mail foi enviado para definição
                    da password.

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-success"
                            data-bs-dismiss="modal">

                        Fechar

                    </button>

                </div>

            </div>

        </div>

    </div>

    <script>
        document.addEventListener(
            'DOMContentLoaded',
            function () {

                var modalEl =
                    document.getElementById(
                        'successModal');

                if (modalEl) {

                    var modal =
                        bootstrap.Modal.getOrCreateInstance(
                            modalEl);

                    modal.show();

                    setTimeout(function () {
                        modal.hide();
                    }, 7000);
                }
            });
    </script>
}

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}


