@{
    ViewData["Title"] = "Área do Passageiro";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <h1 class="mb-4"><i class="fa-solid fa-user"></i> Área do Passageiro</h1>

    <div class="alert alert-info">
        <i class="fa-solid fa-plane-departure"></i>
        Bem-vindo! Aqui pode consultar voos, comprar bilhetes e ver o seu histórico de viagens.
    </div>

    <div class="row">
        <!-- Consultar Voos -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <i class="fa-solid fa-plane fa-2x mb-2 text-primary"></i>
                    <h5 class="card-title">Consultar Voos</h5>
                    <p class="card-text">Veja todos os voos disponíveis e detalhes de horários.</p>
                    <a class="btn btn-outline-primary" href="@Url.Action("Index", "Voo")">
                        <i class="fa-solid fa-plane"></i> Consultar Voos
                    </a>
                </div>
            </div>
        </div>
        <!-- Comprar Bilhetes -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <i class="fa-solid fa-ticket fa-2x mb-2 text-success"></i>
                    <h5 class="card-title">Comprar Bilhetes</h5>
                    <p class="card-text">Adquira bilhetes para os voos disponíveis.</p>
                    <a class="btn btn-outline-success" href="@Url.Action("AdicionarReserva", "Bilhete")">
                        <i class="fa-solid fa-ticket"></i> Comprar Bilhetes
                    </a>
                </div>
            </div>
        </div>
        <!-- Histórico de Viagens -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <i class="fa-solid fa-clock-rotate-left fa-2x mb-2 text-secondary"></i>
                    <h5 class="card-title">Histórico de Viagens</h5>
                    <p class="card-text">Consulte os bilhetes já adquiridos e os voos realizados.</p>
                    <a class="btn btn-outline-secondary" href="@Url.Action("Historico", "Bilhete")">
                        <i class="fa-solid fa-clock-rotate-left"></i> Ver Histórico
                    </a>
                </div>
            </div>
        </div>
    </div>

    <hr />

    <div>
        <h4><i class="fa-solid fa-ellipsis-h"></i> Outras opções</h4>
        <ul class="list-unstyled">
            <li>
                <a href="@Url.Action("Index", "Home")" class="link-primary">
                    <i class="fa-solid fa-house"></i> Voltar ao Início
                </a>
            </li>
            <li>
                <a href="@Url.Action("Perfil", "Passageiros")" class="link-primary">
                    <i class="fa-solid fa-user-pen"></i> Ver/Editar Perfil
                </a>
            </li>
            <li>
                <a href="@Url.Action("Carrinho", "Bilhete")" class="link-primary">
                    <i class="fa-solid fa-shopping-cart"></i> Ver Carrinho de Reservas
                </a>
            </li>
        </ul>
    </div>
</div>




