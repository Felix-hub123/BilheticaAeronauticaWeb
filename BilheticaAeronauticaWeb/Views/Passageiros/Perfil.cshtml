@model BilheticaAeronauticaWeb.Models.PassageiroViewModel

@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <i class="fa-solid fa-user-pen"></i>
            Editar Perfil

        </div>

        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div class="row">

                <div class="col-md-8">

                    <form asp-action="Perfil"
                          method="post"
                          enctype="multipart/form-data"
                          autocomplete="off">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="ImageId" />

                        <div class="mb-3">

                            <label asp-for="Nome"
                                   class="form-label">

                                <i class="fa-solid fa-user"></i>
                                Nome

                            </label>

                            <input asp-for="Nome"
                                   class="form-control" />

                            <span asp-validation-for="Nome"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Apelido"
                                   class="form-label">

                                <i class="fa-solid fa-user-tag"></i>
                                Apelido

                            </label>

                            <input asp-for="Apelido"
                                   class="form-control" />

                            <span asp-validation-for="Apelido"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="DocumentoIdentificacao"
                                   class="form-label">

                                <i class="fa-solid fa-id-card"></i>
                                Documento de Identificação

                            </label>

                            <input asp-for="DocumentoIdentificacao"
                                   class="form-control" />

                            <span asp-validation-for="DocumentoIdentificacao"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="NumeroDocumento"
                                   class="form-label">

                                <i class="fa-solid fa-address-card"></i>
                                Número do Documento

                            </label>

                            <input asp-for="NumeroDocumento"
                                   class="form-control" />

                            <span asp-validation-for="NumeroDocumento"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="DataNascimento"
                                   class="form-label">

                                <i class="fa-solid fa-calendar-days"></i>
                                Data de Nascimento

                            </label>

                            <input asp-for="DataNascimento"
                                   class="form-control"
                                   type="date" />

                            <span asp-validation-for="DataNascimento"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="ImageFile"
                                   class="form-label">

                                <i class="fa-solid fa-camera"></i>
                                Nova Fotografia

                            </label>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" />

                            <span asp-validation-for="ImageFile"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Se não selecionar uma nova fotografia,
                                a fotografia atual será mantida.
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="fa-solid fa-floppy-disk"></i>
                                Guardar Alterações

                            </button>

                            <a asp-action="Historico"
                               class="btn btn-info">

                                <i class="fa-solid fa-clock-rotate-left"></i>
                                Histórico de Viagens

                            </a>

                            <a asp-area="Identity"
                               asp-page="/Account/Manage/ChangePassword"
                               class="btn btn-warning">

                                <i class="fa-solid fa-key"></i>
                                Alterar Password

                            </a>

                        </div>

                    </form>

                </div>

                <div class="col-md-4">

                    <div class="text-center">

                        <h5 class="mb-3">

                            <i class="fa-solid fa-image"></i>
                            Fotografia Atual

                        </h5>

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="Fotografia de @Model.Nome"
                                 class="img-thumbnail shadow"
                                 style="
                                        width:200px;
                                        height:200px;
                                        object-fit:cover;" />
                        }
                        else
                        {
                            <div class="d-flex
                                            align-items-center
                                            justify-content-center
                                            mx-auto
                                            bg-light
                                            border
                                            rounded"
                                 style="
                                        width:200px;
                                        height:200px;">

                                <i class="fa-solid fa-user
                                              text-secondary
                                              display-3">
                                </i>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}

