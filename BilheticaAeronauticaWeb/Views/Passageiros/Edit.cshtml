@model BilheticaAeronauticaWeb.Models.PassageiroViewModel

@{
    ViewData["Title"] = "Editar Passageiro";
}

<h2 class="mb-4">
    <i class="fa-solid fa-user-pen text-primary"></i>
    Editar Passageiro
</h2>

<div class="row">

    <div class="col-md-8">

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <form asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data"
                      autocomplete="off">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <input type="hidden"
                           asp-for="Id" />

                    <input type="hidden"
                           asp-for="ImageId" />

                    <div class="mb-3">

                        <label asp-for="Nome"
                               class="form-label">

                            <i class="fa-solid fa-user"></i>
                            Nome

                        </label>

                        <input asp-for="Nome"
                               class="form-control" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Apelido"
                               class="form-label">

                            <i class="fa-solid fa-user-tag"></i>
                            Apelido

                        </label>

                        <input asp-for="Apelido"
                               class="form-control" />

                        <span asp-validation-for="Apelido"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DocumentoIdentificacao"
                               class="form-label">

                            <i class="fa-solid fa-id-card"></i>
                            Documento de Identificação

                        </label>

                        <input asp-for="DocumentoIdentificacao"
                               class="form-control" />

                        <span asp-validation-for="DocumentoIdentificacao"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="NumeroDocumento"
                               class="form-label">

                            <i class="fa-solid fa-address-card"></i>
                            Número do Documento

                        </label>

                        <input asp-for="NumeroDocumento"
                               class="form-control" />

                        <span asp-validation-for="NumeroDocumento"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DataNascimento"
                               class="form-label">

                            <i class="fa-solid fa-calendar-days"></i>
                            Data de Nascimento

                        </label>

                        <input asp-for="DataNascimento"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DataNascimento"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="ImageFile"
                               class="form-label">

                            <i class="fa-solid fa-camera"></i>
                            Nova Fotografia

                        </label>

                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <span asp-validation-for="ImageFile"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Se não selecionar uma nova fotografia,
                            a fotografia atual será mantida.
                        </div>

                    </div>

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fa-solid fa-floppy-disk"></i>
                            Guardar

                        </button>

                        @if (User.IsInRole("Passageiro"))
                        {
                            <a asp-action="Perfil"
                               class="btn btn-outline-secondary">

                                <i class="fa-solid fa-arrow-left"></i>
                                Voltar ao Perfil

                            </a>
                        }
                        else
                        {
                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="fa-solid fa-arrow-left"></i>
                                Voltar à lista

                            </a>
                        }

                    </div>

                </form>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card shadow-sm">

            <div class="card-body text-center">

                <h5 class="card-title mb-3">

                    <i class="fa-solid fa-image"></i>
                    Fotografia Atual

                </h5>

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="Fotografia de @Model.Nome"
                         class="img-thumbnail shadow"
                         style="
                                width:200px;
                                height:200px;
                                object-fit:cover;" />
                }
                else
                {
                    <div class="d-flex
                                    align-items-center
                                    justify-content-center
                                    mx-auto
                                    bg-light
                                    border
                                    rounded"
                         style="
                                width:200px;
                                height:200px;">

                        <i class="fa-solid fa-user
                                      text-secondary
                                      display-3">
                        </i>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
