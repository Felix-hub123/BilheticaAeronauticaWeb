@model BilheticaAeronauticaWeb.Models.PassageiroViewModel

@{
    ViewData["Title"] = "Detalhes do Passageiro";
}

<h2 class="mb-4">
    <i class="fa-solid fa-user text-primary"></i>
    Detalhes do Passageiro
</h2>

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="row">

            <div class="col-md-8">

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        Nome
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Nome
                    </dd>

                    <dt class="col-sm-4">
                        Apelido
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Apelido
                    </dd>

                    <dt class="col-sm-4">
                        Documento
                    </dt>

                    <dd class="col-sm-8">
                        @Model.DocumentoIdentificacao
                        @Model.NumeroDocumento
                    </dd>

                    <dt class="col-sm-4">
                        Data de Nascimento
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.DataNascimento.HasValue)
                        {
                            @Model.DataNascimento.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-muted">
                                Não definida
                            </span>
                        }

                    </dd>

                </dl>

            </div>

            <div class="col-md-4 text-center">

                <div class="fw-bold mb-3">

                    <i class="fa-solid fa-camera"></i>
                    Fotografia

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="Fotografia de @Model.Nome"
                         class="img-thumbnail shadow"
                         style="
                                width:180px;
                                height:180px;
                                object-fit:cover;" />
                }
                else
                {
                    <div class="d-flex
                                    align-items-center
                                    justify-content-center
                                    mx-auto
                                    bg-light
                                    border
                                    rounded"
                         style="
                                width:180px;
                                height:180px;">

                        <i class="fa-solid fa-user
                                      text-secondary
                                      display-3">
                        </i>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

<div class="d-flex gap-2">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">

        <i class="fa-solid fa-pen-to-square"></i>
        Editar

    </a>

    @if (User.IsInRole("Admin") || User.IsInRole("Funcionario"))
    {
        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left"></i>
            Voltar à lista

        </a>
    }
    else
    {
        <a asp-action="Perfil"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left"></i>
            Voltar ao Perfil

        </a>
    }

</div>