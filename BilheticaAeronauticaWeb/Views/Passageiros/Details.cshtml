@using BilheticaAeronauticaWeb.Data.Entities
@model Passageiro

<h2>Detalhes do Passageiro</h2>
<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">Apelido</dt>
    <dd class="col-sm-10">@Model.Apelido</dd>
    <dt class="col-sm-2">Documento</dt>
    <dd class="col-sm-10">@Model.DocumentoIdentificacao @Model.NumeroDocumento</dd>
    <dt class="col-sm-2">Data Nascimento</dt>
    <dd class="col-sm-10">@Model.DataNascimento?.ToShortDateString()</dd>
    <dt class="col-sm-2">Foto</dt>
    <dd class="col-sm-10">
        <img src="@Url.Content(Model.ImageFullPath)" alt="Foto" width="120" class="rounded" />
    </dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.User?.Email</dd>
</dl>

