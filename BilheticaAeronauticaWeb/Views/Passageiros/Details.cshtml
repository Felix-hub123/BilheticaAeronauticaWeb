@model BilheticaAeronauticaWeb.Data.Entities.Passageiro

@{
    ViewData["Title"] = "Detalhes do Passageiro";
}

<h2 class="mb-4">
    <i class="fa-solid fa-user text-primary"></i> Detalhes do Passageiro
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>
            <dt class="col-sm-3">Apelido</dt>
            <dd class="col-sm-9">@Model.Apelido</dd>
            <dt class="col-sm-3">Documento de Identificação</dt>
            <dt class="col-sm-3">Data de Registo</dt>
            <dd class="col-sm-9">
                @(Model.DataRegisto != DateTime.MinValue ? Model.DataRegisto.ToString("dd/MM/yyyy") : "-")
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="fa-solid fa-pen-to-square"></i> Editar
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i> Voltar à lista
    </a>
</div>
