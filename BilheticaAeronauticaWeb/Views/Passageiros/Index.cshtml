@using BilheticaAeronauticaWeb.Data.Entities
@model IEnumerable<Passageiro>

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Apelido</th>
            <th>Email</th>
            <th>Foto</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Apelido</td>
                <td>@item.User?.Email</td>
                <td>
                    <img src="@Url.Content(item.ImageFullPath)" alt="Foto" width="64" class="img-thumbnail" />
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
