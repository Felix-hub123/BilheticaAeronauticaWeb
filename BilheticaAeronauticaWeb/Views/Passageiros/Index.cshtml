@model IEnumerable<BilheticaAeronauticaWeb.Data.Entities.Passageiro>

@{
    ViewData["Title"] = "Passageiros";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.Apelido)</th>
            <th>@Html.DisplayNameFor(model => model.DocumentoIdentificacao)</th>
            <th>@Html.DisplayNameFor(model => model.DataNascimento)</th>
            <th>@Html.DisplayNameFor(model => model.NumeroDocumento)</th>
            <th>@Html.DisplayNameFor(model => model.DataRegisto)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Nome</td>
            <td>@item.Apelido</td>
            <td>@item.DocumentoIdentificacao</td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataNascimento)
                </td>
            <td>@item.NumeroDocumento</td>
            <td>@item.DataRegisto.ToString("dd/MM/yyyy HH:mm")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>