@model PassageiroViewModel

@{
    var editando = Model.Id > 0;
}
<a asp-action="Historico" class="btn btn-info mb-2">Histórico de Viagens</a>
<a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-warning mb-2">Alterar Password</a>

<h2>@(editando ? "Editar" : "Novo") Passageiro</h2>

<form asp-action="@ViewContext.RouteData.Values["action"]" method="post" enctype="multipart/form-data">
    @if (editando)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div class="mb-3">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger" />
    </div>
    <div class="mb-3">
        <label asp-for="Apelido"></label>
        <input asp-for="Apelido" class="form-control" />
        <span asp-validation-for="Apelido" class="text-danger" />
    </div>
    <div class="mb-3">
        <label asp-for="DocumentoIdentificacao"></label>
        <input asp-for="DocumentoIdentificacao" class="form-control" />
        <span asp-validation-for="DocumentoIdentificacao" class="text-danger" />
    </div>
    <div class="mb-3">
        <label asp-for="NumeroDocumento"></label>
        <input asp-for="NumeroDocumento" class="form-control" />
        <span asp-validation-for="NumeroDocumento" class="text-danger" />
    </div>
    <div class="mb-3">
        <label asp-for="DataNascimento"></label>
        <input asp-for="DataNascimento" type="date" class="form-control" />
        <span asp-validation-for="DataNascimento" class="text-danger" />
    </div>
    <div class="mb-3">
        <label>Foto</label>
        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
        @if (Model.ImageId != Guid.Empty)
        {
            <img src="@Url.Content($"/images/users/{Model.ImageId}.jpg")" width="80" class="rounded mt-2" />
        }
        else
        {
            <img src="/images/users/noimage.png" width="80" class="rounded mt-2" />
        }
        <span asp-validation-for="ImageFile" class="text-danger" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Voltar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

