@model BilheticaAeronauticaWeb.Models.PassageiroViewModel
@{
    ViewData["Title"] = "Criar Passageiro";
}

<h2 class="mb-4">
    <i class="fa-solid fa-user text-primary"></i> Criar Passageiro
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Create" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label">
                    <i class="fa-solid fa-user"></i> Nome
                </label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Apelido" class="form-label">
                    <i class="fa-solid fa-user-tag"></i> Apelido
                </label>
                <input asp-for="Apelido" class="form-control" />
                <span asp-validation-for="Apelido" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DocumentoIdentificacao" class="form-label">
                    <i class="fa-solid fa-id-card"></i> Documento de Identificação
                </label>
                <input asp-for="DocumentoIdentificacao" class="form-control" />
                <span asp-validation-for="DocumentoIdentificacao" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NumeroDocumento" class="form-label">
                    <i class="fa-solid fa-hashtag"></i> Número do Documento
                </label>
                <input asp-for="NumeroDocumento" class="form-control" />
                <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DataNascimento" class="form-label">
                    <i class="fa-solid fa-calendar-day"></i> Data de Nascimento
                </label>
                <input asp-for="DataNascimento" class="form-control" type="date" />
                <span asp-validation-for="DataNascimento" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="fa-solid fa-user-plus"></i> Criar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Voltar à lista
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

