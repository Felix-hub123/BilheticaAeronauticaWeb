@model BilheticaAeronauticaWeb.Data.Entities.Passageiro

@{
    ViewData["Title"] = "Eliminar Passageiro";
}

<h2 class="mb-4 text-danger">
    <i class="fa-solid fa-user-xmark"></i> Eliminar Passageiro
</h2>

<div class="alert alert-warning mb-4">
    <i class="fa-solid fa-triangle-exclamation"></i>
    Tem a certeza que deseja eliminar este passageiro? Esta ação não pode ser desfeita.
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>
            <dt class="col-sm-3">Apelido</dt>
            <dd class="col-sm-9">@Model.Apelido</dd>
            <dt class="col-sm-3">Data de Registo</dt>
            <dd class="col-sm-9">
                @(Model.DataRegisto != DateTime.MinValue ? Model.DataRegisto.ToString("dd/MM/yyyy") : "-")
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger"
                onclick="return confirm('Tem a certeza que deseja eliminar este passageiro?');">
            <i class="fa-solid fa-trash"></i> Eliminar
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left"></i> Voltar à lista
        </a>
    </div>
</form>

