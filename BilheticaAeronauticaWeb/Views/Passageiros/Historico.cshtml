@using BilheticaAeronauticaWeb.Data.Entities
@model IEnumerable<Bilhete>

<h3>Histórico de Viagens</h3>
<table class="table">
    <thead>
        <tr>
            <th>Voo</th>
            <th>Data</th>
            <th>Origem</th>
            <th>Destino</th>
            <th>Lugar</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bilhete in Model)
        {
            <tr>
                <td>@bilhete.Voo.Numero</td>
                <td>@bilhete.Voo.DataHoraPartida.ToString("dd-MM-yyyy HH:mm")</td>
                <td>@bilhete.Voo.Origem.Cidade</td>
                <td>@bilhete.Voo.Destino.Cidade</td>
                <td>@bilhete.Lugar</td>
                <td>@bilhete.Estado</td>
            </tr>
        }
    </tbody>
</table>


