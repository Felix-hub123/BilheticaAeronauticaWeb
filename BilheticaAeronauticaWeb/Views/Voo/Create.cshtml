@model BilheticaAeronauticaWeb.Data.Entities.Voo

@{
    ViewData["Title"] = "Criar Voo";
}

<h1>Criar Voo</h1>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="OrigemId"></label>
        <select asp-for="OrigemId" class="form-control" asp-items="ViewBag.OrigemId"></select>
    </div>
    <div class="form-group">
        <label asp-for="DestinoId"></label>
        <select asp-for="DestinoId" class="form-control" asp-items="ViewBag.DestinoId"></select>
    </div>
    <div class="form-group">
        <label asp-for="AviaoId"></label>
        <select asp-for="AviaoId" class="form-control" asp-items="ViewBag.AviaoId"></select>
    </div>
    <div class="form-group">
        <label asp-for="DataHoraPartida"></label>
        <input asp-for="DataHoraPartida" class="form-control" type="datetime-local" />
    </div>
    <div class="form-group">
        <label asp-for="DataHoraChegada"></label>
        <input asp-for="DataHoraChegada" class="form-control" type="datetime-local" />
    </div>
    <button type="submit" class="btn btn-success">Criar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

