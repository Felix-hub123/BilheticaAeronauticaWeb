@model BilheticaAeronauticaWeb.Models.VooViewModel

@{
    ViewBag.Title = "Criar Voo";
}

<h2>Criar Voo</h2>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="OrigemId"></label>
        <select asp-for="OrigemId" class="form-control" asp-items="@(new SelectList(ViewBag.OrigemId, "Value", "Text"))">
            <option value="">Selecione a origem</option>
        </select>
        <span asp-validation-for="OrigemId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DestinoId"></label>
        <select asp-for="DestinoId" id="DestinoId" class="form-control" asp-items="@(new SelectList(ViewBag.DestinoId, "Value", "Text"))">
            <option value="">Selecione o destino</option>
        </select>
        <span asp-validation-for="DestinoId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="AviaoId"></label>
        <select asp-for="AviaoId" class="form-control" asp-items="@(new SelectList(ViewBag.AviaoId, "Value", "Text"))">
            <option value="">Selecione o avião</option>
        </select>
        <span asp-validation-for="AviaoId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DataHoraPartida"></label>
        <input asp-for="DataHoraPartida" type="datetime-local" class="form-control" />
        <span asp-validation-for="DataHoraPartida" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DataHoraChegada"></label>
        <input asp-for="DataHoraChegada" type="datetime-local" class="form-control" />
        <span asp-validation-for="DataHoraChegada" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PrecoBase"></label>
        <input asp-for="PrecoBase" class="form-control" />
        <span asp-validation-for="PrecoBase" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Criar Voo</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function atualizarTaxaAeroporto() {
            var selectDestino = document.getElementById("DestinoId");
            var inputTaxa = document.getElementById("TaxaAeroporto");
            if (!selectDestino || !inputTaxa) return;

            var destinoId = selectDestino.value;
            if (destinoId) {
                fetch('@Url.Action("ObterTaxa", "Aeroporto")?id=' + destinoId)
                    .then(response => response.json())
                    .then(data => {
                        // Sempre ponto (.), nunca vírgula!
                        inputTaxa.value = data.taxa.toString();
                    })
                    .catch(error => {
                        inputTaxa.value = '';
                    });
            } else {
                inputTaxa.value = '';
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            atualizarTaxaAeroporto();
            var selectDestino = document.getElementById("DestinoId");
            if (selectDestino) {
                selectDestino.addEventListener("change", atualizarTaxaAeroporto);
            }
        });
    </script>
}
}





