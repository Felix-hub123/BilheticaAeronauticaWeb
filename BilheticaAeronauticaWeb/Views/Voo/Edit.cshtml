@model BilheticaAeronauticaWeb.Models.VooViewModel

@{
    ViewData["Title"] = "Editar Voo";
}

<!-- Inclua o css do Flatpickr na View OU (preferencial) no _Layout -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_green.css">
<link rel="stylesheet" href="~/css/voo-form.css" />

<h2 class="mb-4">
    <i class="fa-solid fa-pen-to-square text-primary"></i> Editar Voo
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Edit" method="post" autocomplete="off">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3 dropdown-container">
                <label asp-for="OrigemId" class="form-label">
                    <i class="fa-solid fa-location-dot"></i> Origem
                </label>
                <select asp-for="OrigemId" class="form-select custom-width" asp-items="ViewBag.OrigemId"></select>
                <span asp-validation-for="OrigemId" class="text-danger"></span>
            </div>

            <div class="mb-3 dropdown-container">
                <label asp-for="DestinoId" class="form-label">
                    <i class="fa-solid fa-location-dot"></i> Destino
                </label>
                <select asp-for="DestinoId" id="DestinoId" class="form-select custom-width" asp-items="ViewBag.DestinoId"></select>
                <span asp-validation-for="DestinoId" class="text-danger"></span>
            </div>

            <div class="mb-3 dropdown-container">
                <label asp-for="AviaoId" class="form-label">
                    <i class="fa-solid fa-plane"></i> Avião
                </label>
                <select asp-for="AviaoId" class="form-select custom-width" asp-items="ViewBag.AviaoId"></select>
                <span asp-validation-for="AviaoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DataHoraPartida" class="form-label">
                    <i class="fa-solid fa-clock"></i> Data/Hora Partida
                </label>
                <input asp-for="DataHoraPartida" class="form-control datetimepicker" type="text" autocomplete="off" />
                <span asp-validation-for="DataHoraPartida" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataHoraChegada" class="form-label">
                    <i class="fa-solid fa-clock"></i> Data/Hora Chegada
                </label>
                <input asp-for="DataHoraChegada" class="form-control datetimepicker" type="text" autocomplete="off" />
                <span asp-validation-for="DataHoraChegada" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrecoBase" class="form-label">
                    <i class="fa-solid fa-euro-sign"></i> Preço do Voo
                </label>
                <input asp-for="PrecoBase" class="form-control" type="number" min="1" step="0.01" />
                <span asp-validation-for="PrecoBase" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-save"></i> Salvar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        flatpickr(".datetimepicker", {
            enableTime: true,
            dateFormat: "d/m/Y H:i",
            time_24hr: true
        });

       
        document.getElementById("DestinoId").addEventListener("change", function () {
            var destinoId = this.value;
            if (destinoId) {
                fetch('/Aeroporto/ObterTaxa?id=' + destinoId)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById("TaxaAeroporto").value = data.taxa.toFixed(2).replace('.', ',');
                    })
                    .catch(error => {
                        document.getElementById("TaxaAeroporto").value = '';
                    });
            } else {
                document.getElementById("TaxaAeroporto").value = '';
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


