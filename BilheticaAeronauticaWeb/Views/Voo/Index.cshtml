@model IEnumerable<BilheticaAeronauticaWeb.Models.VooIndexViewModel>

@{
    ViewData["Title"] = "Lista de Voos";
}

<h2 class="mb-4">
    <i class="fa-solid fa-plane text-primary"></i>
    Lista de Voos
</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

@if (User.IsInRole("Funcionario") ||
     User.IsInRole("Admin"))
{
    <div class="mb-3">

        <a asp-action="Create"
           class="btn btn-success">

            <i class="fa-solid fa-plus"></i>
            Criar Novo Voo

        </a>

    </div>
}

<div class="table-responsive">

    <table class="table table-striped table-hover align-middle">

        <thead class="table-dark sticky-top">

            <tr>

                <th>
                    Nº Voo
                </th>

                <th>
                    Origem
                </th>

                <th>
                    Destino
                </th>

                <th>
                    Avião
                </th>

                <th>
                    Partida
                </th>

                <th>
                    Chegada
                </th>

                <th>
                    Ações
                </th>

            </tr>

        </thead>

        <tbody>

            @if (Model == null || !Model.Any())
            {
                <tr>

                    <td colspan="7"
                        class="text-center text-muted py-4">

                        <i class="fa-solid fa-plane-slash me-2"></i>
                        Nenhum voo encontrado.

                    </td>

                </tr>
            }
            else
            {
                @foreach (var voo in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @voo.Numero
                            </strong>
                        </td>

                        <td>

                            <div class="d-flex align-items-center">

                                @if (!string.IsNullOrWhiteSpace(voo.OrigemImageUrl))
                                {
                                    <img src="@voo.OrigemImageUrl"
                                         alt="@voo.OrigemNome"
                                         class="me-2"
                                         style="
                                                         width:40px;
                                                         height:26px;
                                                         object-fit:cover;
                                                         border-radius:4px;
                                                         border:1px solid #dee2e6;" />
                                }

                                <span>
                                    @voo.OrigemNome
                                </span>

                            </div>

                        </td>

                        <td>

                            <div class="d-flex align-items-center">

                                @if (!string.IsNullOrWhiteSpace(voo.DestinoImageUrl))
                                {
                                    <img src="@voo.DestinoImageUrl"
                                         alt="@voo.DestinoNome"
                                         class="me-2"
                                         style="
                                                         width:40px;
                                                         height:26px;
                                                         object-fit:cover;
                                                         border-radius:4px;
                                                         border:1px solid #dee2e6;" />
                                }

                                <span>
                                    @voo.DestinoNome
                                </span>

                            </div>

                        </td>

                        <td>

                            <i class="fa-solid fa-plane text-primary me-2"></i>

                            @voo.AviaoModelo

                        </td>

                        <td>

                            <i class="fa-regular fa-calendar me-1 text-muted"></i>

                            @voo.DataHoraPartida.ToString("dd/MM/yyyy HH:mm")

                        </td>

                        <td>

                            <i class="fa-regular fa-calendar-check me-1 text-muted"></i>

                            @voo.DataHoraChegada.ToString("dd/MM/yyyy HH:mm")

                        </td>

                        <td>

                            <div class="d-flex">

                                <a asp-action="Details"
                                   asp-route-id="@voo.Id"
                                   class="btn btn-info btn-sm me-1"
                                   title="Detalhes">

                                    <i class="fa-solid fa-circle-info"></i>

                                </a>

                                @if (User.IsInRole("Funcionario") ||
                                                        User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@voo.Id"
                                       class="btn btn-warning btn-sm me-1"
                                       title="Editar">

                                        <i class="fa-solid fa-pen-to-square"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@voo.Id"
                                       class="btn btn-danger btn-sm"
                                       title="Eliminar">

                                        <i class="fa-solid fa-trash"></i>

                                    </a>
                                }

                            </div>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>