@model BilheticaAeronauticaWeb.Data.Entities.Voo

@{
    ViewBag.Title = "Eliminar Voo";
}

<h2>Eliminar Voo</h2>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.ErrorMessage
    </div>
}

<div class="alert alert-warning mb-4">
    <i class="fa-solid fa-triangle-exclamation"></i>
    Tem a certeza que pretende eliminar este voo? Esta ação não pode ser desfeita.
</div>


<dl class="row">
    <dt class="col-sm-2">Nº</dt>
    <dd class="col-sm-10">@Model.Numero</dd>
    <dt class="col-sm-2">Origem</dt>
    <dd class="col-sm-10">@Model.Origem?.Nome</dd>
    <dt class="col-sm-2">Destino</dt>
    <dd class="col-sm-10">@Model.Destino?.Nome</dd>
    <dt class="col-sm-2">Avião</dt>
    <dd class="col-sm-10">@Model.Aviao?.Modelo</dd>
    <dt class="col-sm-2">Partida</dt>
    <dd class="col-sm-10">@Model.DataHoraPartida:dd/MM/yyyy HH:mm</dd>
    <dt class="col-sm-2">Chegada</dt>
    <dd class="col-sm-10">@Model.DataHoraChegada:dd/MM/yyyy HH:mm</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="confirmDeleteCheck"
               onchange="document.getElementById('btnDelete').disabled = !this.checked" />
        <label class="form-check-label" for="confirmDeleteCheck">
            Confirmo que pretendo eliminar este voo.
        </label>
    </div>
    <div class="d-flex gap-2">
        <button id="btnDelete" type="submit" class="btn btn-danger" disabled>
            <i class="fa-solid fa-trash"></i> Eliminar
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left"></i> Cancelar
        </a>
    </div>
</form>





