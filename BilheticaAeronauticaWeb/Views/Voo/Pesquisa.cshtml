@model PesquisaVoosViewModel
@using System.Globalization

<div class="container mt-4">
    <h2>
        <i class="fa-solid fa-magnifying-glass-plane text-primary"></i> Pesquisa de Voos
    </h2>
    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Pesquisa" method="post" class="row g-3 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Data de Partida</label>
                    <input asp-for="DataPartida" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Origem</label>
                    <select asp-for="OrigemId" asp-items="Model.Aeroportos" class="form-select">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Destino</label>
                    <select asp-for="DestinoId" asp-items="Model.Aeroportos" class="form-select">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-12 d-flex justify-content-end mt-3">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa-solid fa-search"></i> Pesquisar
                    </button>
                </div>
            </form>

            @if (Model != null && Model.Resultados != null)
            {
                if (Model.Resultados.Any())
                {
                    <div class="alert alert-success">
                        Foram encontrados <b>@Model.Resultados.Count</b> voos.
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-striped table-hover align-middle shadow-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Origem</th>
                                    <th>Destino</th>
                                    <th>Partida</th>
                                    <th>Chegada</th>
                                    <th>Preço</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var voo in Model.Resultados)
                                {
                                    <tr>
                                        <td>@voo.Origem?.Nome</td>
                                        <td>@voo.Destino?.Nome</td>
                                        <td>@voo.DataHoraPartida.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                                        <td>@voo.DataHoraChegada.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                                        <td>
                                            @if (voo.PrecoBase > 0)
                                            {
                                                @voo.PrecoBase.ToString("C", CultureInfo.CurrentCulture)
                                            }
                                            else
                                            {
                                                <span class="text-muted">Consultar</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Details" asp-route-id="@voo.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="fa-solid fa-circle-info"></i> Detalhes
                                            </a>
                                            @if (User.Identity.IsAuthenticated && User.IsInRole("Cliente"))
                                            {
                                                <a asp-action="Comprar" asp-route-id="@voo.Id" class="btn btn-success btn-sm ms-2">
                                                    <i class="fa-solid fa-ticket"></i> Comprar
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mt-4">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Nenhum voo encontrado com os critérios selecionados.
                    </div>
                }
            }
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
