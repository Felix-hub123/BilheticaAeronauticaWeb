@{
    ViewData["Title"] = "Painel do Administrador";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-4">
    <h1 class="mb-4"><i class="fa-solid fa-user-shield"></i> Painel do Administrador</h1>

    <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i>
        Bem-vindo, administrador! Utilize os atalhos abaixo para gerir o sistema.
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <i class="fa-solid fa-building fa-2x mb-2 text-primary"></i>
                    <h5 class="card-title">Aeroportos</h5>
                    <p class="card-text">Criar, editar e remover aeroportos.</p>
                    <a class="btn btn-outline-primary" href="@Url.Action("Index", "Aeroportos")">
                        <i class="fa-solid fa-building"></i> Gerir Aeroportos
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <i class="fa-solid fa-users-gear fa-2x mb-2 text-warning"></i>
                    <h5 class="card-title">Funcionários</h5>
                    <p class="card-text">Gerir contas de funcionários do sistema.</p>
                    <a class="btn btn-outline-warning" href="@Url.Action("Index", "GestaoFuncionario")">
                        <i class="fa-solid fa-users-gear"></i> Gerir Funcionários
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <i class="fa-solid fa-jet-fighter fa-2x mb-2 text-info"></i>
                    <h5 class="card-title">Aeronaves</h5>
                    <p class="card-text">Gerir tipos de aeronaves.</p>
                    <a class="btn btn-outline-info" href="@Url.Action("Index", "Avioes")">
                        <i class="fa-solid fa-jet-fighter"></i> Gerir Aeronaves
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>


