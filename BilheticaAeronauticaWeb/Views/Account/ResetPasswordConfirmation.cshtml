@{
    ViewData["Title"] = "Password Redefinida";
}

<div class="alert alert-success mt-5 text-center">
    <i class="fa-solid fa-check-circle fa-2x"></i>
    <h2 class="mt-3">Password redefinida com sucesso!</h2>
    <p>Será redirecionado para a página de login em alguns segundos...</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-4">
        Ir para Login agora
    </a>
</div>

<script>
    setTimeout(function () {
        window.location.href = "@Url.Action("Login", "Account")";
    }, 4000); 
</script>


