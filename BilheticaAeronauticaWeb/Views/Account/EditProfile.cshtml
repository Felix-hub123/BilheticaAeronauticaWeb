@using BilheticaAeronauticaWeb.Model
@model EditProfileViewModel

@{
    ViewData["Title"] = "Editar Perfil";
}

<h2>Editar Perfil</h2>
<form asp-action="EditProfile" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Apelido"></label>
        <input asp-for="Apelido" class="form-control" />
        <span asp-validation-for="Apelido" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" readonly />
    </div>


    <div class="mb-3">
        <label asp-for="ImageFile">Foto de Perfil</label>
        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
        @if (Model.ImageId != Guid.Empty)
        {
            <img src="https://bilheticaapp.blob.core.windows.net/users/@Model.ImageId?v=@DateTime.Now.Ticks" style="height:80px;" class="rounded mt-2" />
        }
        else
        {
            <img src="/images/users/noimage.png" style="height:80px;" class="rounded mt-2" />
        }
    </div>
    <button type="submit" class="btn btn-primary mt-3">Salvar Alterações</button>
</form>
@if (ViewBag.Message != null)
{
    <div class="alert alert-success mt-3">@ViewBag.Message</div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



