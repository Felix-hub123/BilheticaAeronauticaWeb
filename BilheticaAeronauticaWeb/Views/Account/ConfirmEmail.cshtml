@{
    ViewData["Title"] = "Confirmação de Email";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow p-4 text-center" style="max-width: 400px;">
        <div class="card-header bg-info text-dark mb-3">
            <i class="fa-solid fa-circle-check fa-2x text-success"></i>
            <h4 class="mt-2">Confirmação de Email</h4>
        </div>
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">@ViewBag.Message</div>
        }
        else
        {
            <div class="alert alert-info">O seu email foi confirmado com sucesso!</div>
        }
        <a asp-action="Login" class="btn btn-outline-primary mt-4">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> Ir para Login
        </a>
    </div>
</div>

