@{
    ViewData["Title"] = "Confirmação de Registo";
}

<h1 class="mb-4 text-success">
    Conta Criada com Sucesso
</h1>

<p class="alert alert-success" role="alert">
    @ViewBag.Message ?? "Registo realizado com sucesso! Por favor, verifica o teu email para confirmar a conta."
</p>

<p class="alert alert-success mt-3" role="alert">
    Serás redirecionado automaticamente para a página inicial em alguns segundos.
</p>

<a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">
    Ir para Home agora
</a>

<script>
    setTimeout(function () {
        window.location.href = '@Url.Action("Index", "Admin")';
    }, 4000);
</script>


