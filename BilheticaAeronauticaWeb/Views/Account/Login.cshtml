@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/23.1.40/ej2-base/styles/material.css" />
<link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/23.1.40/ej2-buttons/styles/material.css" />
<link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/23.1.40/ej2-inputs/styles/material.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow p-4" style="max-width:400px;">
        <div class="card-header bg-primary text-white text-center mb-3">
            <i class="fa-solid fa-plane-up fa-2x"></i>
            <h4 class="mt-2">Autenticação</h4>
        </div>
        <form asp-action="Login" method="post" class="needs-validation" novalidate>
            <div class="form-group mb-3">
                <label asp-for="Email"><i class="fa-solid fa-envelope-open-text me-2"></i>Email</label>
                <input asp-for="Email" class="e-input form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Password"><i class="fa-solid fa-key me-2"></i>Password</label>
                <input asp-for="Password" type="password" class="e-input form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="e-btn e-primary w-100 mb-2">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Entrar
            </button>
            <div class="d-flex justify-content-between">
                <a asp-action="Register" class="small"><i class="fa-solid fa-user-plus me-1"></i>Criar Conta</a>
                <a asp-action="ForgotPassword" class="small"><i class="fa-solid fa-unlock-keyhole me-1"></i>Recuperar Password</a>
            </div>
        </form>
        </div>
</div>
