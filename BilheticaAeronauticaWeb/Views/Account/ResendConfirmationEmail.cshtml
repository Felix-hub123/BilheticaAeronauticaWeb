@{
    ViewData["Title"] = "Reenviar confirmação";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-3">
                        Reenviar email de confirmação
                    </h2>

                    <p class="text-muted">
                        Introduza o email utilizado no registo.
                    </p>

                    <form asp-action="ResendConfirmationEmail"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label for="email"
                                   class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Reenviar email
                        </button>

                    </form>

                    <div class="mt-3 text-center">
                        <a asp-action="Login">
                            Voltar ao login
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>