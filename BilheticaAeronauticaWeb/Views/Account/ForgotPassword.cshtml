@using SuperShop.Models
@model RecoverPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Palavra-passe";
}
<link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/23.1.40/ej2-base/styles/material.css" />
<link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/23.1.40/ej2-buttons/styles/material.css" />
<link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/23.1.40/ej2-inputs/styles/material.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow p-4" style="max-width:400px;">
        <div class="card-header bg-warning text-dark text-center mb-3">
            <i class="fa-solid fa-lock-open fa-2x"></i>
            <h4 class="mt-2">Recuperar palavra-passe</h4>
        </div>
        <form asp-action="ForgotPassword" method="post" novalidate>
            <div class="form-group mb-3">
                <label asp-for="Email"><i class="fa-solid fa-envelope me-2"></i>Email</label>
                <input asp-for="Email" class="e-input form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="e-btn e-warning w-100">
                <i class="fa-solid fa-paper-plane me-2"></i> Enviar recuperação
            </button>
        </form>
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-info mt-2">@ViewBag.Message</div>
        }
    </div>
</div>



