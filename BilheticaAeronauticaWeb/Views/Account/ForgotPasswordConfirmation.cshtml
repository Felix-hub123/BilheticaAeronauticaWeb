@{
    ViewData["Title"] = "Recuperação de Password";
}

<div class="alert alert-info mt-5 text-center">
    <i class="fa-solid fa-envelope fa-2x"></i>
    <h2 class="mt-3">Instruções enviadas!</h2>
    <p>
        Se o email existir, foi enviado um link para redefinir a sua password.<br />
        Por favor verifique a sua caixa de entrada.
    </p>
    <a asp-controller="Account" asp-action="Login" class="mt-3 btn btn-primary">
        Voltar ao Login
    </a>
</div>


