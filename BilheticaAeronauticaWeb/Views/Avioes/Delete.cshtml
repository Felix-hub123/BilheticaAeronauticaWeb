@model BilheticaAeronauticaWeb.Data.Entities.Aviao

@{
    ViewData["Title"] = "Eliminar Avião";
}

<h1 class="mb-4 text-danger">
    <i class="fa-solid fa-trash-can"></i> Eliminar Avião
</h1>

<div class="alert alert-warning d-flex align-items-center" role="alert">
    <i class="fa-solid fa-triangle-exclamation fa-lg me-2"></i>
    <div>
        Tem a certeza que deseja eliminar este avião? Esta ação não pode ser desfeita.
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3"><i class="fa-solid fa-industry text-primary"></i> Marca</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Marca)</dd>

            <dt class="col-sm-3"><i class="fa-solid fa-plane text-primary"></i> Modelo</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Modelo)</dd>

            <dt class="col-sm-3"><i class="fa-solid fa-chair text-primary"></i> Lugares Económica</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.LugaresEconomica)</dd>

            <dt class="col-sm-3"><i class="fa-solid fa-couch text-primary"></i> Lugares Executiva</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.LugaresExecutiva)</dd>

            <dt class="col-sm-3"><i class="fa-solid fa-image text-primary"></i> Imagem</dt>
            <dd class="col-sm-9">
                <img src="@Url.Content(Model.ImageFullPath)" alt="Imagem do avião" class="img-thumbnail" style="max-width:120px; height:auto;" />
            </dd>

            <dt class="col-sm-3"><i class="fa-solid fa-toggle-on text-primary"></i> Disponível</dt>
            <dd class="col-sm-9">
                @if (Model.Disponivel)
                {
                    <span class="badge bg-success"><i class="fa-solid fa-check"></i> Sim</span>
                }
                else
                {
                    <span class="badge bg-danger"><i class="fa-solid fa-xmark"></i> Não</span>
                }
            </dd>
        </dl>
        <form asp-action="Delete" class="mt-4 d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash"></i> Eliminar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Voltar à Lista
            </a>
        </form>
    </div>
</div>

