@model IEnumerable<BilheticaAeronauticaWeb.Data.Entities.Aviao>

@{
    ViewData["Title"] = "Lista de Aviões";
}

<h1 class="mb-4">
    <i class="fa-solid fa-plane-circle-check text-primary"></i> Lista de Aviões
</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> Novo Avião
    </a>
</div>

<table class="table table-striped table-hover align-middle shadow-sm">
    <thead class="table-primary">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Marca)</th>
            <th>@Html.DisplayNameFor(model => model.Modelo)</th>
            <th>@Html.DisplayNameFor(model => model.LugaresEconomica)</th>
            <th>@Html.DisplayNameFor(model => model.LugaresExecutiva)</th>
            <th>Imagem</th>
            <th>@Html.DisplayNameFor(model => model.Disponivel)</th>
            <th class="text-center">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Marca)</td>
                <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                <td>@Html.DisplayFor(modelItem => item.LugaresEconomica)</td>
                <td>@Html.DisplayFor(modelItem => item.LugaresExecutiva)</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageFullPath))
                    {
                        <img src="@Url.Content(item.ImageFullPath)" alt="Imagem do avião" class="img-thumbnail" style="width:80px; height:auto;" />
                    }
                </td>
                <td>
                    @if (item.Disponivel)
                    {
                        <span class="badge bg-success"><i class="fa-solid fa-check"></i> Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-danger"><i class="fa-solid fa-xmark"></i> Não</span>
                    }
                </td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1" title="Editar">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm me-1 text-white" title="Detalhes">
                        <i class="fa-solid fa-circle-info"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Eliminar">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
