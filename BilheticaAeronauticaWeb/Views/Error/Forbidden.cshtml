@{
    Layout = "_Layout";
    ViewData["Title"] = "403 - Acesso negado";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 p-5">
                <h1 class="display-1 text-warning mb-4">403</h1>
                <h2 class="mb-3">Acesso negado</h2>
                <p class="lead mb-4">@ViewBag.ErrorMessage ?? "Não tens permissão para aceder a esta página." </p>
                <a href="/" class="btn btn-primary btn-lg">
                    <i class="bi bi-arrow-left-circle-fill me-2"></i>Voltar para o Início
                </a>
            </div>
        </div>
    </div>
</div>



