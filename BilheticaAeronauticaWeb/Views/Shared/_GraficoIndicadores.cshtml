@using Syncfusion.EJ2.Charts

<div class="container mt-5 mb-5">
    <h3 class="text-center mb-4">Indicadores da Companhia</h3>

    <ejs-chart id="chartAero">
        <e-chart-primaryxaxis valueType="Category"></e-chart-primaryxaxis>

        <e-series-collection>
            <e-series dataSource="@(new[] {
                                          new { Indicador = "Pontualidade (%)", Valor = 95 },
                                          new { Indicador = "Satisfação (%)", Valor = 92 },
                                          new { Indicador = "Passageiros (mil)", Valor = 120 }
                                      })"
                      xName="Indicador"
                      yName="Valor"
                      type="Column">
            </e-series>
        </e-series-collection>
    </ejs-chart>
</div>


