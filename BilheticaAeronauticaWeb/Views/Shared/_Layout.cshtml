@using Microsoft.AspNetCore.Identity
@using BilheticaAeronauticaWeb.Data.Entities 
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    User currentUser = null;
    if (User.Identity.IsAuthenticated)
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroTicket</title>
    <link rel="icon" href="~/favicon.png" type="image/png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_green.css">
    <link href="https://cdn.syncfusion.com/ej2/22.1.34/fluent.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.syncfusion.com/ej2/23.1.36/material.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg" style="background-color: #1196ff;">
        <div class="container-fluid">
            @{
                var ctrl = "Home";
                if (User.Identity.IsAuthenticated)
                    ctrl = User.IsInRole("Admin") ? "Admin" :
                    User.IsInRole("Funcionario") ? "Funcionarios" :
                    User.IsInRole("Passageiro") ? "Passageiros" :
                    "Home";
            }
            <a class="navbar-brand fw-bold text-white"
               asp-controller="@ctrl"
               asp-action="Index">
                <i class="fa-solid fa-plane-departure"></i> AEROTICKET
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mb-2 mb-lg-0 align-items-center">

                    @if (User.Identity.IsAuthenticated && currentUser != null)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown" role="button">
                                <img src="@(currentUser.ImageFullPath)?v=@DateTime.Now.Ticks"
                                     alt="Foto de Perfil"
                                     class="rounded-circle me-2"
                                     style="width:32px; height:32px; object-fit:cover;" />
                                <span>Olá, @((currentUser.Nome + " " + currentUser.Apelido).Trim())!</span>
                            </a>
                            

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="EditProfile">
                                        <i class="fa-solid fa-id-badge me-2"></i>Ver/Editar Perfil
                                    </a>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Login">
                                <i class="fa-solid fa-sign-in-alt"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Register">
                                <i class="fa-solid fa-user-plus"></i> Registar
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="aero-footer text-center py-3 mt-5">
        <div class="footer-animate">
            <i class="fa-solid fa-plane-departure"></i> © 2025 Bilhética Aeronáutica. Todos os direitos reservados.
        </div>
    </footer>

    <div aria-live="polite" aria-atomic="true" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
        <div id="globalToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Mensagem</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body"></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          var toastEl = document.getElementById('globalToast');
          if (toastEl) {
            var toast = new bootstrap.Toast(toastEl);
            var toastBody = toastEl.querySelector('.toast-body');
            toastBody.textContent = '@TempData["Mensagem"]';
            if (toastBody.textContent.trim().length > 0) {
              toast.show();
            }
          }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.syncfusion.com/ej2/23.1.36/dist/ej2.min.js"></script>
</body>
</html>




