<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroTicket</title>
    <link rel="icon" href="~/favicon.png" type="image/png" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_green.css" />
    <link href="https://cdn.syncfusion.com/ej2/30.1.40/fluent.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg" style="background-color: #1196ff;">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-white"
               asp-controller="Home"
               asp-action="Painel">
                <i class="fa-solid fa-plane-departure"></i> AEROTICKET
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Voo" asp-action="Pesquisa">Pesquisar Voos</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @await Component.InvokeAsync("UserProfileImage", new { displayMode = "largeImage" })
                        @await Component.InvokeAsync("UserProfileImage", new { displayMode = "nameAndDropdown" })
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="aero-footer text-center py-3 mt-5">
        <div class="footer-animate">
            <i class="fa-solid fa-plane-departure"></i> © 2025 Bilhética Aeronáutica. Todos os direitos reservados.
        </div>
    </footer>


    <div aria-live="polite" aria-atomic="true" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="globalToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Mensagem</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Fechar"></button>
            </div>
            <div class="toast-body" style="display:none;">@TempData["Mensagem"]</div>
        </div>
    </div>


    @if (TempData["ShowSuccessModal"] != null)
    {
        <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title" id="modalLabel">Sucesso</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body fs-5">
                        @TempData["ShowSuccessModal"]
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" data-bs-dismiss="modal">Fechar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/30.1.40/dist/ej2.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Mostrar Toast com mensagem
            var toastEl = document.getElementById('globalToast');
            var toastBodyEl = toastEl.querySelector('.toast-body');
            var message = toastBodyEl.textContent.trim();
            if (message.length > 0) {
                toastBodyEl.style.display = "block";
                var toast = new bootstrap.Toast(toastEl);
                toast.show();
            }

            // Mostrar modal sucesso
            var modalEl = document.getElementById('successModal');
            if (modalEl) {
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
                setTimeout(() => modal.hide(), 7000);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @Html.EJS().ScriptManager()
</body>
</html>
