@using BilheticaAeronauticaWeb.Data.Entities
@using Syncfusion.EJ2.Navigations
@using Syncfusion.EJ2.CircularGauge

@{
    ViewData["Title"] = "Bem-vindo à AeroTicket";
}

<link rel="stylesheet" href="~/css/site-home.css" />

<section class="home-hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="hero-badge">
                    <i class="fa-solid fa-plane-departure"></i>
                    AeroTicket
                </span>

                <h1 class="hero-title">
                    Encontre o seu próximo voo
                    de forma simples e rápida.
                </h1>

                <p class="hero-subtitle">
                    Pesquise voos, escolha o seu lugar,
                    compre o bilhete e acompanhe a sua viagem
                    numa única plataforma.
                </p>

                <div class="hero-actions">

                    <a asp-controller="Voo"
                       asp-action="Pesquisa"
                       class="btn btn-primary btn-lg hero-primary-btn">

                        <i class="fa-solid fa-magnifying-glass me-2"></i>
                        Pesquisar Voos

                    </a>

                    <a asp-controller="Voo"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-lg hero-secondary-btn">

                        <i class="fa-solid fa-plane me-2"></i>
                        Ver Voos

                    </a>

                </div>

                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="hero-account-actions">

                        <span>
                            Ainda não tem conta?
                        </span>

                        <a asp-controller="Account"
                           asp-action="Register">

                            Criar conta

                        </a>

                        <span class="mx-2">•</span>

                        <a asp-controller="Account"
                           asp-action="Login">

                            Entrar

                        </a>

                    </div>
                }

            </div>

            <div class="col-lg-5 mt-5 mt-lg-0">

                <div class="hero-info-card">

                    <div class="hero-info-icon">
                        <i class="fa-solid fa-ticket"></i>
                    </div>

                    <div>
                        <span class="hero-info-label">
                            Bilhética simples
                        </span>

                        <h4>
                            Tudo o que precisa para viajar
                        </h4>

                        <p>
                            Consulte horários, disponibilidade,
                            lugares e informações do seu voo
                            sem complicações.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


@if (User.Identity.IsAuthenticated)
{
    <section class="user-dashboard-shortcut">

        <div class="container">

            <div class="dashboard-shortcut-card">

                <div>

                    <span class="dashboard-small-title">
                        Bem-vindo de volta
                    </span>

                    <h4 class="mb-1">
                        Aceda rapidamente ao seu painel
                    </h4>

                    <p class="mb-0 text-muted">
                        Consulte as funcionalidades disponíveis
                        para o seu perfil.
                    </p>

                </div>

                <div>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="btn btn-dark">

                            <i class="fa-solid fa-user-shield me-2"></i>
                            Painel de Administração

                        </a>
                    }
                    else if (User.IsInRole("Funcionario"))
                    {
                        <a asp-controller="Funcionarios"
                           asp-action="Index"
                           class="btn btn-success">

                            <i class="fa-solid fa-user-tie me-2"></i>
                            Painel do Funcionário

                        </a>
                    }
                    else if (User.IsInRole("Passageiro"))
                    {
                        <a asp-controller="Passageiro"
                           asp-action="Index"
                           class="btn btn-info text-white">

                            <i class="fa-solid fa-user me-2"></i>
                            Painel do Passageiro

                        </a>
                    }

                </div>

            </div>

        </div>

    </section>
}


<section class="home-stats">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-eyebrow">
                AeroTicket em números
            </span>

            <h2>
                Viajar começa com informação clara
            </h2>

            <p>
                Consulte alguns indicadores da plataforma.
            </p>

        </div>

        <div class="row g-4 mt-2">

            <div class="col-md-4">

                <div class="stat-card">

                    <div class="stat-icon stat-icon-blue">

                        <i class="fa-solid fa-plane-departure"></i>

                    </div>

                    <div>

                        <span class="stat-label">
                            Voos disponíveis
                        </span>

                        <h3>
                            155
                        </h3>

                        <p>
                            disponíveis para consulta
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="stat-card">

                    <div class="stat-icon stat-icon-yellow">

                        <i class="fa-solid fa-ticket"></i>

                    </div>

                    <div>

                        <span class="stat-label">
                            Bilhetes vendidos
                        </span>

                        <h3>
                            13.2K
                        </h3>

                        <p>
                            nos últimos 30 dias
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="stat-card">

                    <div class="stat-icon stat-icon-cyan">

                        <i class="fa-solid fa-location-dot"></i>

                    </div>

                    <div>

                        <span class="stat-label">
                            Destinos
                        </span>

                        <h3>
                            48
                        </h3>

                        <p>
                            cidades disponíveis
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="home-carousel-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-eyebrow">
                Descubra
            </span>

            <h2>
                A sua próxima experiência começa aqui
            </h2>

        </div>

        <div id="mainCarousel"
             class="carousel slide home-carousel"
             data-bs-ride="carousel">

            <div class="carousel-inner">

                <div class="carousel-item active">

                    <img src="~/images/carrossel/voo1.jpg"
                         class="d-block w-100"
                         alt="Viagem aérea"
                         loading="lazy" />

                    <div class="home-carousel-overlay"></div>

                    <div class="carousel-caption home-carousel-caption">

                        <span>
                            Conforto e confiança
                        </span>

                        <h2>
                            Viaje com segurança
                        </h2>

                        <p>
                            Uma experiência simples,
                            desde a pesquisa até ao embarque.
                        </p>

                    </div>

                </div>

                <div class="carousel-item">

                    <img src="~/images/carrossel/voo2.jpg"
                         class="d-block w-100"
                         alt="Novos destinos"
                         loading="lazy" />

                    <div class="home-carousel-overlay"></div>

                    <div class="carousel-caption home-carousel-caption">

                        <span>
                            Explore o mundo
                        </span>

                        <h2>
                            Descubra novos destinos
                        </h2>

                        <p>
                            Encontre novas rotas
                            e prepare a sua próxima viagem.
                        </p>

                    </div>

                </div>

                <div class="carousel-item">

                    <img src="~/images/carrossel/voo3.jpg"
                         class="d-block w-100"
                         alt="Experiência AeroTicket"
                         loading="lazy" />

                    <div class="home-carousel-overlay"></div>

                    <div class="carousel-caption home-carousel-caption">

                        <span>
                            AeroTicket
                        </span>

                        <h2>
                            Uma viagem mais simples
                        </h2>

                        <p>
                            Gestão de voos e bilhetes
                            num único lugar.
                        </p>

                    </div>

                </div>

            </div>

            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#mainCarousel"
                    data-bs-slide="prev">

                <span class="carousel-control-prev-icon"></span>

                <span class="visually-hidden">
                    Anterior
                </span>

            </button>

            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#mainCarousel"
                    data-bs-slide="next">

                <span class="carousel-control-next-icon"></span>

                <span class="visually-hidden">
                    Próximo
                </span>

            </button>

        </div>

    </div>

</section>


<section class="home-benefits">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-eyebrow">
                Porquê AeroTicket?
            </span>

            <h2>
                Tudo pensado para uma melhor experiência
            </h2>

            <p>
                Segurança, simplicidade e informação
                em todas as etapas da sua viagem.
            </p>

        </div>

        <div class="row g-4 mt-2">

            <div class="col-md-4">

                <div class="benefit-card">

                    <div class="benefit-icon">

                        <i class="fa-solid fa-shield-halved"></i>

                    </div>

                    <h4>
                        Segurança
                    </h4>

                    <p>
                        Informação organizada e processos
                        simples para uma experiência tranquila.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="benefit-card">

                    <div class="benefit-icon">

                        <i class="fa-solid fa-clock"></i>

                    </div>

                    <h4>
                        Rapidez
                    </h4>

                    <p>
                        Consulte voos e informações
                        importantes em poucos passos.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="benefit-card">

                    <div class="benefit-icon">

                        <i class="fa-solid fa-headset"></i>

                    </div>

                    <h4>
                        Apoio
                    </h4>

                    <p>
                        Uma plataforma preparada para acompanhar
                        o passageiro durante toda a viagem.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="home-how-it-works">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-eyebrow">
                Como funciona
            </span>

            <h2>
                Do voo ao bilhete em quatro passos
            </h2>

        </div>

        <div class="row g-4 mt-3">

            <div class="col-md-3 col-sm-6">

                <div class="step-card">

                    <span class="step-number">
                        1
                    </span>

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <h5>
                        Pesquisar
                    </h5>

                    <p>
                        Escolha origem,
                        destino e data.
                    </p>

                </div>

            </div>

            <div class="col-md-3 col-sm-6">

                <div class="step-card">

                    <span class="step-number">
                        2
                    </span>

                    <i class="fa-solid fa-chair"></i>

                    <h5>
                        Escolher
                    </h5>

                    <p>
                        Selecione o voo
                        e o lugar pretendido.
                    </p>

                </div>

            </div>

            <div class="col-md-3 col-sm-6">

                <div class="step-card">

                    <span class="step-number">
                        3
                    </span>

                    <i class="fa-solid fa-credit-card"></i>

                    <h5>
                        Comprar
                    </h5>

                    <p>
                        Confirme os dados
                        e finalize a compra.
                    </p>

                </div>

            </div>

            <div class="col-md-3 col-sm-6">

                <div class="step-card">

                    <span class="step-number">
                        4
                    </span>

                    <i class="fa-solid fa-plane"></i>

                    <h5>
                        Viajar
                    </h5>

                    <p>
                        Consulte o seu bilhete
                        e prepare a viagem.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="home-final-cta">

    <div class="container">

        <div class="final-cta-card">

            <div>

                <span>
                    Pronto para viajar?
                </span>

                <h2>
                    Encontre o voo ideal para si.
                </h2>

                <p>
                    Comece agora a pesquisar
                    os voos disponíveis.
                </p>

            </div>

            <a asp-controller="Voo"
               asp-action="Pesquisa"
               class="btn btn-light btn-lg">

                <i class="fa-solid fa-plane-departure me-2"></i>
                Pesquisar Voos

            </a>

        </div>

    </div>

</section>
