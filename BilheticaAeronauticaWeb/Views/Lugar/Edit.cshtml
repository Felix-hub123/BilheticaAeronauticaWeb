@model BilheticaAeronauticaWeb.Data.Entities.Lugar

@{
    ViewData["Title"] = "Editar Lugares";
}

<h1>Editar Voo</h1>
<h2>Editar Lugar</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Codigo"></label>
        <input asp-for="Codigo" class="form-control" />
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AviaoId">Avião</label>
        <select asp-for="AviaoId" class="form-control" asp-items="ViewBag.Aviaos"></select>
    </div>
    <div class="form-group">
        <label asp-for="VooId">Voo</label>
        <select asp-for="VooId" class="form-control" asp-items="ViewBag.Voos"></select>
    </div>
    <div class="form-group">
        <label asp-for="Disponivel"></label>
        <input asp-for="Disponivel" type="checkbox" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>

