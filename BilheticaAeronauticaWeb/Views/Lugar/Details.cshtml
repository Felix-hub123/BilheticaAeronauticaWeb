@model BilheticaAeronauticaWeb.Data.Entities.Lugar
@{
    ViewData["Title"] = "Details";
}

<h2>Detalhes do Lugar</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">@Model.Codigo</dd>
        <dt class="col-sm-2">Disponível</dt>
        <dd class="col-sm-10">@Model.Disponivel</dd>
        <dt class="col-sm-2">Avião</dt>
        <dd class="col-sm-10">@Model.Aviao?.Modelo</dd>
        <dt class="col-sm-2">Voo</dt>
        <dd class="col-sm-10">@Model.Voo?.Id</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
