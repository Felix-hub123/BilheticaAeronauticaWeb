@model BilheticaAeronauticaWeb.Data.Entities.Voo

@{
    ViewData["Title"] = "Eliminar Lugar";
}

<h2>Eliminar Lugar</h2>

<h3>Tens a certeza que queres eliminar este lugar?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">@Model.AviaoId</dd>
        <dt class="col-sm-2">Avião</dt>
        <dd class="col-sm-10">@Model.Aviao?.Modelo</dd>
        <dt class="col-sm-2">Voo</dt>
        <dd class="col-sm-10">@Model.Id</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

